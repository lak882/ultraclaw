{
  "permissions": {
    "mode": "normal",
    "modes": {
      "strict": {
        "description": "Require confirmation for all destructive operations",
        "confirmBeforePush": true,
        "confirmBeforeReset": true,
        "confirmBeforeDelete": true,
        "confirmBeforeProductionStateChange": true,
        "confirmBeforeSend": true,
        "allowFileEdits": false,
        "allowServerEdits": false,
        "dryRunFirst": true
      },
      "normal": {
        "description": "Confirm destructive operations, allow standard edits",
        "confirmBeforePush": false,
        "confirmBeforeReset": true,
        "confirmBeforeDelete": true,
        "confirmBeforeProductionStateChange": false,
        "confirmBeforeSend": false,
        "allowFileEdits": true,
        "allowServerEdits": true,
        "dryRunFirst": true
      },
      "permissive": {
        "description": "Allow edits without confirmation, confirm only resets/deletes",
        "confirmBeforePush": false,
        "confirmBeforeReset": true,
        "confirmBeforeDelete": true,
        "confirmBeforeProductionStateChange": false,
        "confirmBeforeSend": false,
        "allowFileEdits": true,
        "allowServerEdits": true,
        "dryRunFirst": false
      },
      "dangerously-skip-permissions": {
        "description": "No confirmations, full auto ? use with caution",
        "confirmBeforePush": false,
        "confirmBeforeReset": false,
        "confirmBeforeDelete": false,
        "confirmBeforeProductionStateChange": false,
        "confirmBeforeSend": false,
        "allowFileEdits": true,
        "allowServerEdits": true,
        "dryRunFirst": false
      }
    },
    "guardrails": {
      "neverDeleteWithRunningProduction": true,
      "alwaysBackupBeforeDeploy": true,
      "maxResetPackagesPerCommand": 3,
      "requireNamespaceMatch": true
    }
  },
  "cost": {
    "position": "top",
    "showOnReadOnly": false,
    "showOnCreate": true,
    "format": "{input} input \u00b7 {output} output \u00b7 {duration} \u00b7 {cost}",
    "pricing": {
      "inputPerMTok": 3,
      "outputPerMTok": 15
    },
    "createCommands": [
      "dtl",
      "production",
      "rule",
      "bpl",
      "poc",
      "json-adapter",
      "host",
      "lookup",
      "push",
      "reset",
      "reset-force",
      "interview"
    ],
    "readOnlyCommands": [
      "list",
      "pull",
      "trace",
      "errors",
      "connect",
      "send",
      "diagram",
      "validate",
      "cost"
    ]
  },
  "telemetry": {
    "enabled": true,
    "logPath": "data/telemetry",
    "retentionDays": 90
  },
  "feedback": {
    "enabled": true,
    "provider": "github",
    "github": {
      "repo": "lak882/claude-connector-gitlab-mirror",
      "credentialId": "GitHubFeedback",
      "labels": [
        "feedback"
      ]
    },
    "categories": [
      "bug",
      "feature-request",
      "general",
      "praise"
    ]
  },
  "gitlab": {
    "url": "",
    "projectId": "",
    "token": "",
    "branchPrefix": "skills/",
    "defaultLabels": [
      "interclaw"
    ]
  }
}