{
  "description": "IRIS Installation Configuration - Edit values below for your installation",
  "version": "1.0",

  "installations": {
    "irisclaw-analytics": {
      "description": "Analytics instance on port 5555 via Apache CSP Gateway",

      "instance": {
        "name": "irisclaw-analytics",
        "create_new": "Y",
        "directory": "/usr/local/InterSystems/irisclaw-analytics"
      },

      "installation_type": {
        "question": "Select installation type: 1) Development 2) Server only 3) Custom",
        "options": {
          "1": "Development - Install IRIS server and all language bindings",
          "2": "Server only - Install IRIS server",
          "3": "Custom"
        },
        "selected": "1"
      },

      "security": {
        "initial_level": {
          "question": "How restrictive do you want the initial Security settings to be?",
          "options": {
            "1": "Locked Down (most secure)",
            "2": "Normal (least restrictive)"
          },
          "selected": "2"
        },
        "password": "SYS",
        "csp_password": "SYS",
        "configure_additional": "N"
      },

      "ownership": {
        "instance_owner_user": "lkabelka",
        "instance_owner_group": "sales",
        "effective_group": "irisusr",
        "superserver_user": "irisusr"
      },

      "ports": {
        "superserver_port": 1975,
        "webserver_port": 52775
      },

      "features": {
        "unicode": {
          "question": "Do you want to install IRIS Unicode support?",
          "answer": "Y"
        },
        "private_web_server": {
          "question": "Do you want to install Private Web Server?",
          "answer": "Y"
        },
        "ipm": {
          "question": "Do you want to install InterSystems Package Manager?",
          "answer": "Y"
        }
      },

      "license": {
        "enter_key": "Y",
        "license_file": "/home/lkabelka/isc.key"
      },

      "csp_gateway": {
        "configure_web": "Y",
        "directory": "/opt/webgateway",
        "url_prefix": "/irisclaw-analytics"
      },

      "post_install": {
        "add_to_csp_gateway": true,
        "apache_restart": true,
        "add_to_servers_json": true,
        "test_connection": true
      }
    },

    "template": {
      "description": "Template for new installations - copy and customize",

      "instance": {
        "name": "INSTANCE_NAME",
        "create_new": "Y",
        "directory": "/usr/local/InterSystems/INSTANCE_NAME"
      },

      "installation_type": {
        "selected": "1"
      },

      "security": {
        "initial_level": {
          "selected": "2"
        },
        "password": "SYS",
        "csp_password": "SYS",
        "configure_additional": "N"
      },

      "ownership": {
        "instance_owner_user": "lkabelka",
        "instance_owner_group": "sales",
        "effective_group": "irisusr",
        "superserver_user": "irisusr"
      },

      "ports": {
        "superserver_port": "AUTO",
        "webserver_port": "AUTO",
        "_comment": "AUTO will find next available port starting from 1972 (super) and 52773 (web)"
      },

      "features": {
        "unicode": {
          "answer": "Y"
        },
        "private_web_server": {
          "answer": "Y"
        },
        "ipm": {
          "answer": "Y"
        }
      },

      "license": {
        "enter_key": "Y",
        "license_file": "/home/lkabelka/iris.key"
      },

      "csp_gateway": {
        "configure_web": "Y",
        "directory": "/opt/webgateway",
        "url_prefix": "/INSTANCE_NAME"
      },

      "post_install": {
        "add_to_csp_gateway": true,
        "apache_restart": true,
        "add_to_servers_json": true,
        "test_connection": true
      }
    }
  },

  "_question_reference": {
    "description": "Complete list of IRIS installer questions in order",
    "questions": [
      {
        "order": 1,
        "prompt": "Enter instance name:",
        "type": "text",
        "maps_to": "instance.name"
      },
      {
        "order": 2,
        "prompt": "Do you want to create IRISHealth instance '<name>' <Yes>?",
        "type": "yes/no",
        "default": "Yes",
        "maps_to": "instance.create_new"
      },
      {
        "order": 3,
        "prompt": "Enter a destination directory for the new instance.",
        "type": "path",
        "validation": "must be absolute path",
        "maps_to": "instance.directory"
      },
      {
        "order": 4,
        "prompt": "Select installation type. 1) Development 2) Server only 3) Custom",
        "type": "choice",
        "options": ["1", "2", "3"],
        "default": "1",
        "maps_to": "installation_type.selected"
      },
      {
        "order": 5,
        "prompt": "How restrictive do you want the initial Security settings to be? 1) Locked Down 2) Normal",
        "type": "choice",
        "options": ["1", "2"],
        "default": "1",
        "maps_to": "security.initial_level.selected"
      },
      {
        "order": 6,
        "prompt": "What user should be the owner of this instance?",
        "type": "text",
        "validation": "must be valid system user",
        "maps_to": "ownership.instance_owner_user"
      },
      {
        "order": 7,
        "prompt": "What group should be allowed to start and stop this instance?",
        "type": "text",
        "validation": "must be valid system group",
        "maps_to": "ownership.instance_owner_group"
      },
      {
        "order": 8,
        "prompt": "What is the effective group for IRIS processes?",
        "type": "text",
        "validation": "must be valid system group",
        "maps_to": "ownership.effective_group"
      },
      {
        "order": 9,
        "prompt": "What is the effective user for SuperServer and its jobs?",
        "type": "text",
        "validation": "must be valid system user",
        "maps_to": "ownership.superserver_user"
      },
      {
        "order": 10,
        "prompt": "Enter the SuperServer port number <default>:",
        "type": "number",
        "range": "1024-65535",
        "default": "1972",
        "maps_to": "ports.superserver_port"
      },
      {
        "order": 11,
        "prompt": "Enter the WebServer port number <default>:",
        "type": "number",
        "range": "1024-65535",
        "default": "52773",
        "maps_to": "ports.webserver_port"
      },
      {
        "order": 12,
        "prompt": "Do you want to install IRIS Unicode support <Yes>?",
        "type": "yes/no",
        "default": "Yes",
        "maps_to": "features.unicode.answer"
      },
      {
        "order": 13,
        "prompt": "Do you want to install Private Web Server <Yes>?",
        "type": "yes/no",
        "default": "Yes",
        "maps_to": "features.private_web_server.answer"
      },
      {
        "order": 14,
        "prompt": "Do you want to install InterSystems Package Manager <Yes>?",
        "type": "yes/no",
        "default": "Yes",
        "maps_to": "features.ipm.answer"
      },
      {
        "order": 15,
        "prompt": "Do you want to enter a license key <No>?",
        "type": "yes/no",
        "default": "No",
        "maps_to": "license.enter_key"
      },
      {
        "order": 16,
        "prompt": "License key file:",
        "type": "path",
        "validation": "must exist and be readable",
        "maps_to": "license.license_file"
      },
      {
        "order": 17,
        "prompt": "Local web server detected. Would you like to use the web server to connect to this installation <Yes>?",
        "type": "yes/no",
        "default": "Yes",
        "maps_to": "csp_gateway.configure_web"
      },
      {
        "order": 18,
        "prompt": "Enter CSP Gateway directory:",
        "type": "path",
        "default": "/opt/webgateway",
        "maps_to": "csp_gateway.directory"
      }
    ]
  }
}
