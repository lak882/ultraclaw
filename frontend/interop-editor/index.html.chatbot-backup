    function getToolIcon(toolName) {
      if (TOOL_ICONS[toolName]) return TOOL_ICONS[toolName];
      return TOOL_ICONS.wrench;
    }

    function ensureStepsContainer() {
      if (currentStepsEl) return;
      if (!currentStreamEl) return;
      currentStepsEl = document.createElement('div');
      currentStepsEl.className = 'reasoning-steps';

      // Steps list (create first so toggle can capture it)
      currentStepsListEl = document.createElement('div');
      currentStepsListEl.className = 'reasoning-list';

      // Toggle button — capture listEl in closure so it survives finalize
      var toggle = document.createElement('button');
      toggle.className = 'reasoning-toggle';
      // Start EXPANDED during execution
      toggle.innerHTML = '<span class="chevron-icon open">' + CHEVRON_SVG + '</span> Hide steps';
      currentStepsListEl.style.display = '';
      (function(listEl, btn) {
        var visible = true;
        btn.onclick = function() {
          visible = !visible;
          if (visible) {
            listEl.style.display = '';
            btn.innerHTML = '<span class="chevron-icon open">' + CHEVRON_SVG + '</span> Hide steps';
          } else {
