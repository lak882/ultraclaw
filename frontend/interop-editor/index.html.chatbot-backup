    function renderMarkdown(text) {
      // Escape HTML
      var html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Code blocks (must be first to protect content inside)
      var codeBlocks = [];
      html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(m, lang, code) {
        var idx = codeBlocks.length;
        codeBlocks.push('<pre class="chatbot-codeblock"><code>' + code.trimEnd() + '</code></pre>');
        return '\x00CODEBLOCK' + idx + '\x00';
      });

      // Inline code (protect from further processing)
      var inlineCodes = [];
      html = html.replace(/`([^`]+)`/g, function(m, code) {
        var idx = inlineCodes.length;
        inlineCodes.push('<code class="chatbot-inline-code">' + code + '</code>');
        return '\x00INLINE' + idx + '\x00';
      });

      // Tables
      html = html.replace(/^(\|.+\|)\n(\|[\s\-:|]+\|)\n((?:\|.+\|\n?)+)/gm, function(m, header, sep, body) {
        var headers = header.split('|').filter(function(c){return c.trim()});
        var rows = body.trim().split('\n');
        var table = '<table class="chatbot-table"><thead><tr>';
        headers.forEach(function(h) { table += '<th>' + h.trim() + '</th>'; });
        table += '</tr></thead><tbody>';
        rows.forEach(function(row) {
          var cells = row.split('|').filter(function(c){return c.trim()});
          table += '<tr>';
          cells.forEach(function(c) { table += '<td>' + c.trim() + '</td>'; });
          table += '</tr>';
        });
        table += '</tbody></table>';
        return table;
      });

      // Horizontal rules (standalone --- lines, not inside tables)
      html = html.replace(/^---+$/gm, '<hr class="chatbot-hr">');

      // Headers
      html = html.replace(/^#### (.+)$/gm, '<h5 class="chatbot-h">$1</h5>');
      html = html.replace(/^### (.+)$/gm, '<h4 class="chatbot-h">$1</h4>');
      html = html.replace(/^## (.+)$/gm, '<h3 class="chatbot-h">$1</h3>');
      html = html.replace(/^# (.+)$/gm, '<h2 class="chatbot-h">$1</h2>');

      // Bold (before italic)
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/__(.+?)__/g, '<strong>$1</strong>');

      // Italic
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/_(.+?)_/g, '<em>$1</em>');

      // Links
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="chatbot-link">$1</a>');

      // Ordered lists (must come before unordered to distinguish)
      html = html.replace(/(?:^\d+\. .+\n?)+/gm, function(m) {
        var items = m.trim().split('\n').map(function(line) {
          return '<li>' + line.replace(/^\d+\. /, '') + '</li>';
        }).join('');
        return '<ol class="chatbot-list-ordered">' + items + '</ol>';
      });

      // Unordered lists
      html = html.replace(/(?:^[\-\*] .+\n?)+/gm, function(m) {
        var items = m.trim().split('\n').map(function(line) {
          return '<li>' + line.replace(/^[\-\*] /, '') + '</li>';
        }).join('');
        return '<ul class="chatbot-list">' + items + '</ul>';
      });

      // Line breaks: convert newlines to <br>, then aggressively clean around block elements
      html = html.replace(/\n/g, '<br>');

      // Restore code blocks and inline code FIRST
      html = html.replace(/\x00CODEBLOCK(\d+)\x00/g, function(m, i) { return codeBlocks[parseInt(i)]; });
      html = html.replace(/\x00INLINE(\d+)\x00/g, function(m, i) { return inlineCodes[parseInt(i)]; });

      // Clean up <br> around ALL block elements (after restore)
      var blocks = 'pre|ul|ol|table|h[2-5]|hr|div|blockquote|strong';
      html = html.replace(new RegExp('(<br>\\s*)+(<(' + blocks + ')[^>]*>)', 'gi'), '$2');
      html = html.replace(new RegExp('(<\\/(' + blocks + ')>)\\s*(<br>\\s*)+', 'gi'), '$1');
      // Collapse 3+ consecutive <br> to double (keep intentional paragraph breaks)
      html = html.replace(/(<br\s*\/?>[\s]*){3,}/gi, '<br><br>');
      // Remove leading/trailing <br>
      html = html.replace(/^(\s*<br\s*\/?>[\s]*)+/i, '');
      html = html.replace(/(\s*<br\s*\/?>[\s]*)+$/i, '');

      // Add portal links for IRIS component class names
      html = linkifyComponents(html);

      return html;
    }

    function linkifyComponents(html) {
      var ns = detectNamespace() || 'HSLIB';
      var cspBase = window.location.origin + '/csp/healthshare/' + ns.toLowerCase();
      // Match dotted class names (3+ segments like Pkg.Sub.Name) NOT already inside an HTML tag or anchor
      return html.replace(/(?<![\/\w"=])(\b[A-Z][A-Za-z0-9]*(?:\.[A-Z][A-Za-z0-9]*){2,})\b(?!\.cls)(?![^<]*>)/g, function(m, cls) {
        // Skip if inside a code block or already linked
        var lower = cls.toLowerCase();
        var url = null;
        var label = null;
        if (lower.indexOf('.dtl.') !== -1) {
          url = cspBase + '/EnsPortal.DTLEditor.zen?DT=' + cls + '.dtl';
          label = 'Open in DTL Editor';
        } else if (lower.indexOf('.rule.') !== -1 || lower.endsWith('routingrule')) {
          url = cspBase + '/EnsPortal.RuleEditor.zen?$NAMESPACE=' + ns + '&rule=' + cls;
          label = 'Open in Rule Editor';
        } else if (lower.indexOf('.bpl.') !== -1) {
          url = cspBase + '/EnsPortal.BPLEditor.zen?BP=' + cls + '.bpl';
          label = 'Open in BPL Editor';
        } else if (lower.endsWith('.production') || lower.endsWith('production')) {
          url = cspBase + '/EnsPortal.ProductionConfig.zen?PRODUCTION=' + cls;
          label = 'Open Production';
        }
        if (url) {
          return '<a href="' + url + '" target="_blank" class="chatbot-link" title="' + label + '">' + cls + ' &#x2197;</a>';
        }
        return cls;
      });
    }

    function saveState() {
      var state = {
        sessionId: sessionId,
        messages: []
      };
      var children = document.getElementById('chatbot-content').children;
      for (var i = 0; i < children.length; i++) {
        var el = children[i];
        // Handle wrapper divs — find the actual message inside
        var msgEl = el.classList.contains('chatbot-msg-wrap') ? el.querySelector('.chatbot-message') : el;
        if (!msgEl) continue;
        var type = 'assistant';
        if (msgEl.classList.contains('chatbot-message-user')) type = 'user';
        else if (msgEl.classList.contains('chatbot-message-system')) type = 'system';
        else if (msgEl.classList.contains('chatbot-message-error')) type = 'error';
        else if (msgEl.classList.contains('chatbot-message-tool')) type = 'tool';
        state.messages.push({ type: type, html: msgEl.innerHTML });
      }
      sessionStorage.setItem('chatbot-state', JSON.stringify(state));
    }

    function restoreState() {
      var saved = sessionStorage.getItem('chatbot-state');
      if (!saved) return false;
      try {
        var state = JSON.parse(saved);
        if (!state.sessionId) return false;

        sessionId = state.sessionId;
        var content = document.getElementById('chatbot-content');

        // Restore messages
        state.messages.forEach(function(m) {
          var msg = document.createElement('div');
          msg.className = 'chatbot-message';
          if (m.type === 'user') msg.className += ' chatbot-message-user';
          else if (m.type === 'system') msg.className += ' chatbot-message-system';
          else if (m.type === 'error') msg.className += ' chatbot-message-error';
          else if (m.type === 'tool') msg.className += ' chatbot-message-tool';
          msg.innerHTML = m.html;
          // Only wrap user and assistant messages
          if (m.type === 'user' || m.type === 'assistant') {
            var wrap = document.createElement('div');
            wrap.className = 'chatbot-msg-wrap' + (m.type === 'user' ? ' chatbot-msg-wrap--user' : '');
            wrap.appendChild(msg);
            content.appendChild(wrap);
          } else {
            content.appendChild(msg);
          }
        });

        content.scrollTop = content.scrollHeight;

        sessionReady = true;
        updateStatus('Connected');

        return true;
      } catch(e) {
        return false;
      }
    }

    function formatTimestamp() {
      var now = new Date();
      var h = now.getHours(); var m = now.getMinutes();
      var ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + ':' + (m < 10 ? '0' : '') + m + ' ' + ampm;
    }

    function createTimestamp() {
      var ts = document.createElement('div');
      ts.className = 'msg-timestamp';
      ts.textContent = formatTimestamp();
      return ts;
    }

    function wrapMessage(msgEl, isUser) {
      var wrap = document.createElement('div');
      wrap.className = 'chatbot-msg-wrap' + (isUser ? ' chatbot-msg-wrap--user' : '');
      wrap.appendChild(msgEl);
      wrap.appendChild(createTimestamp());
      return wrap;
    }

    function addMessageWithFiles(type, text, fileNames) {
      if (!fileNames || fileNames.length === 0) return addMessage(type, text);
      var content = document.getElementById('chatbot-content');
      var wrap = document.createElement('div');
      wrap.className = 'chatbot-msg-wrap chatbot-msg-wrap--user';
      // File chips row
      var chipsRow = document.createElement('div');
      chipsRow.className = 'sent-file-chips';
      fileNames.forEach(function(name) {
        chipsRow.innerHTML += '<div class="sent-file-chip">' +
          '<div class="chip-icon">' + getFileIcon(name) + '</div>' +
          '<div class="chip-info">' +
            '<span class="chip-name">' + escapeHtml(name) + '</span>' +
            '<span class="chip-label">' + getFileLabel(name) + '</span>' +
          '</div></div>';
      });
      wrap.appendChild(chipsRow);
      // Message bubble
      if (text.trim()) {
        var msg = document.createElement('div');
        msg.className = 'chatbot-message chatbot-message-user';
        msg.textContent = text;
        wrap.appendChild(msg);
      }
      content.appendChild(wrap);
      content.scrollTop = content.scrollHeight;
      saveState();
    }

    function addMessage(type, text) {
      removeTypingIndicator(); removeInitialLoader();
      text = (text || '').trim();
      if (!text) return;
      var content = document.getElementById('chatbot-content');

      // For assistant messages, always create a new bubble
      if (type === 'assistant') {
        var assistantMsg = document.createElement('div');
        assistantMsg.className = 'chatbot-message';
        assistantMsg.innerHTML = '<div class="msg-content">' + renderMarkdown(text) + '</div>';
        content.appendChild(wrapMessage(assistantMsg, false));
        content.scrollTop = content.scrollHeight;
        saveState();
        return;
      }

      var msg = document.createElement('div');
      msg.className = 'chatbot-message';
      if (type === 'user') msg.className += ' chatbot-message-user';
      else if (type === 'system') msg.className += ' chatbot-message-system';
      else if (type === 'error') msg.className += ' chatbot-message-error';

      msg.textContent = text;
      if (type === 'user' || type === 'assistant') {
        content.appendChild(wrapMessage(msg, type === 'user'));
      } else {
        content.appendChild(msg);
      }
      content.scrollTop = content.scrollHeight;
      saveState();
    }

    /** Read an SSE stream from a fetch Response and dispatch events */
    async function readSSE(response) {
      var reader = response.body.getReader();
      var decoder = new TextDecoder();
      var buffer = '';

      while (true) {
        var result = await reader.read();
        if (result.done) break;
        buffer += decoder.decode(result.value, { stream: true });

        var lines = buffer.split('\n');
        buffer = lines.pop(); // keep incomplete line in buffer

        for (var i = 0; i < lines.length; i++) {
          var line = lines[i].trim();
          if (line.indexOf('data: ') !== 0) continue;
          try {
            var data = JSON.parse(line.substring(6));
            handleEvent(data);
          } catch (e) { /* skip malformed */ }
        }
      }
    }

    /** Finalize the current streaming bubble so the next text starts a fresh one */
    function finalizeCurrentBubble() {
      removeTypingIndicator();
      removeBubbleThinkingBar();
      if (currentStreamEl && currentStreamText) {
        clearTimeout(renderTimeout);
        renderTimeout = null;
        var trimmed = currentStreamText.trim();
        var contentEl = currentStreamEl.querySelector('.msg-content');
        if (contentEl && trimmed) contentEl.innerHTML = renderMarkdown(trimmed);
        // Remove empty bubbles (remove the wrapper)
        if (!trimmed && currentStreamWrap && currentStreamWrap.parentNode) {
          currentStreamWrap.parentNode.removeChild(currentStreamWrap);
        }
      }
      currentStreamEl = null;
      currentStreamWrap = null;
      currentStreamText = '';
      currentThinkingEl = null;
      currentThinkingText = '';
      collapseReasoningSteps();
      resetReasoningSteps();
    }

    function handleEvent(data) {
      var chatMessages = document.getElementById('chatbot-content');
      // Reset response timeout on any event — backend is alive
      resetResponseTimeout();

      switch (data.type) {
        case 'status':
          updateStatus(data.text);
          if (data.text === 'Ready') {
            updateStatus('Connected');
            clearResponseTimeout();
            saveState();
          }
          break;
        case 'delta':
          if (suppressAssistant) break;
          if (!currentStreamEl) break;
          // First delta after thinking: clear thinking text from msg-content
          if (isStreamingThinking) {
            isStreamingThinking = false;
            var contentEl = currentStreamEl.querySelector('.msg-content');
            if (contentEl) contentEl.innerHTML = '';
            currentStreamText = '';
          }
          if (!timerInterval) {
            updateStatus('Generating...');
          }
          currentStreamText += data.text;
          if (!renderTimeout) {
            renderTimeout = setTimeout(function() {
              var contentEl = currentStreamEl.querySelector('.msg-content');
              if (contentEl) contentEl.innerHTML = renderMarkdown(currentStreamText.replace(/Token usage:.*(?:\n|$)/g, ''));
              chatMessages.scrollTop = chatMessages.scrollHeight;
              renderTimeout = null;
            }, 80);
          }
          break;
        case 'thinking':
          if (suppressAssistant) break;
          if (!currentStreamEl) break;
          isStreamingThinking = true;
          currentThinkingText = data.text;
          // Stream thinking text into msg-content as the main text
          if (!renderTimeout) {
            renderTimeout = setTimeout(function() {
              var contentEl = currentStreamEl.querySelector('.msg-content');
              if (contentEl) contentEl.innerHTML = renderMarkdown(currentThinkingText);
              chatMessages.scrollTop = chatMessages.scrollHeight;
              renderTimeout = null;
            }, 80);
          }
          break;
        case 'output':
          if (suppressAssistant) break;
          var outputText = (data.text || '').trim();
          if (!outputText) break;
          if (!currentStreamEl) break;
          // First output after thinking: clear thinking text
          if (isStreamingThinking) {
            isStreamingThinking = false;
            var ce = currentStreamEl.querySelector('.msg-content');
            if (ce) ce.innerHTML = '';
            currentStreamText = '';
          }
          // Render previous text instantly, only animate new text
          var prevText = currentStreamText;
          currentStreamText += (currentStreamText ? '\n\n' : '') + outputText;
          var mc = currentStreamEl.querySelector('.msg-content');
          if (mc) {
            if (prevText) mc.innerHTML = renderMarkdownWithQuickReplies(prevText);
            (function(el, prev, added, scroll) {
              animateText(el, added, scroll, prev);
            })(mc, prevText, outputText, chatMessages);
          }
          break;
        case 'session':
          sessionId = data.session_id;
          sessionReady = true;
          saveState();
          processQueue();
          break;
        case 'error':
          stopTimer();
          clearResponseTimeout();
          addMessage('error', data.text);
          updateStatus('Error');
          if (data.text && data.text.indexOf('Invalid session') !== -1) {
            sessionStorage.removeItem('chatbot-state');
            sessionId = null;
            sessionReady = false;
            initSession();
          }
          break;
        case 'tool_use':
          updateStatus('Using ' + data.tool + '...');
          if (!currentStreamEl) break;
          // Finalize any running thinking step
          if (currentThinkingEl) {
            updateReasoningStep(currentThinkingEl.id, { status: 'success' });
            currentThinkingEl = null;
            currentThinkingText = '';
          }
          stepCounter++;
          var toolStep = {
            id: 'tool-' + stepCounter,
            type: 'tool',
            title: (function() {
              try {
                var inp = JSON.parse(data.input || '{}');
                var arg = '';
                var t = data.tool;
                if (t === 'Bash') arg = inp.command || '';
                else if (t === 'Skill') arg = inp.skill || '';
                else if (t === 'Read') arg = inp.file_path || '';
                else if (t === 'Edit') arg = inp.file_path || '';
                else if (t === 'Grep') arg = inp.pattern || '';
                else if (t === 'Glob') arg = inp.pattern || '';
                else if (t === 'Write') arg = inp.file_path || '';
                if (arg) {
                  return t + '(' + arg + ')';
                }
              } catch(e) {}
              return 'Using ' + data.tool;
            })(),
            toolName: data.tool,
            content: data.input ? data.input.substring(0, 2000) : '',
            rawOutput: null,
            status: 'running',
            resultCount: 0
          };
          addReasoningStep(toolStep);
          chatMessages.scrollTop = chatMessages.scrollHeight;
          break;
        case 'tool_result':
          updateStatus('Thinking...');
          // Update the first RUNNING tool step (handles back-to-back tool_use)
          var lastToolStep = null;
          for (var si = 0; si < currentSteps.length; si++) {
            if (currentSteps[si].type === 'tool' && currentSteps[si].status === 'running') { lastToolStep = currentSteps[si]; break; }
          }
          if (lastToolStep) {
            var resultText = (data.text || '').substring(0, 4000);
            var resultCount = 0;
            try {
              var parsed = JSON.parse(data.text || '');
              if (Array.isArray(parsed)) resultCount = parsed.length;
            } catch(e) {}
            updateReasoningStep(lastToolStep.id, {
              status: 'success',
              content: resultText.split('\n').slice(0, 10).join('\n'),
              rawOutput: data.text || '',
              resultCount: resultCount
            });
          }
          chatMessages.scrollTop = chatMessages.scrollHeight;
          break;
        case 'goto-reload':
          // Legacy: treat as goto with editor type (no reload needed)
          if (data.target) {
            console.log('[goto-detect] backend detected /goto-reload (legacy):', data.target);
            (function(t, e) { setTimeout(function() { executeGoto(t, e); }, 500); })(data.target, data.editor || null);
          }
          break;
        case 'goto':
          if (data.target) {
            console.log('[goto-detect] backend detected /goto:', data.target, 'editor:', data.editor);
            (function(t, e) { setTimeout(function() { executeGoto(t, e); }, 500); })(data.target, data.editor || null);
          }
          break;
        case 'reload':
          console.log('[goto-detect] backend detected /reload');
          sessionStorage.setItem('chatbot-programmatic-reload', 'true');
          saveState();
          setTimeout(function() { window.location.reload(); }, 500);
          break;
        case 'usage':
          var elapsed = queryStartTime ? ((Date.now() - queryStartTime) / 1000).toFixed(1) : '?';
          usageShown = true;
          var inTok = data.input_tokens || 0;
          var outTok = data.output_tokens || 0;
          if (!suppressAssistant) {
            lastTurnTokens += inTok + outTok;
            lastInputTokens += inTok;
            lastOutputTokens += outTok;
          }
          var elSec = parseFloat(elapsed);
          var durStr = elSec >= 60 ? Math.floor(elSec/60) + 'm ' + Math.round(elSec%60) + 's' : elapsed + 's';
          var inK = (lastInputTokens / 1000).toFixed(1);
          var outK = (lastOutputTokens / 1000).toFixed(1);
          var costUsd = ((lastInputTokens * 3 + lastOutputTokens * 15) / 1000000).toFixed(2);
          lastUsageText = durStr + ' \u00b7 $' + costUsd + ' \u00b7 ' + inK + 'k tokens in \u00b7 ' + outK + 'k tokens out';
          break;
        case 'done':
          stopTimer();
          clearResponseTimeout();
          currentAbortController = null;
          hideStopButton();
          totalTokensAccum += lastTurnTokens;
          if (lastTurnTokens > 0) updateTokenCounter(totalTokensAccum);
          // Transform thinking bar into usage metadata
          transformThinkingToUsage();
          removeTypingIndicator();
          for (var di = 0; di < currentSteps.length; di++) {
            if (currentSteps[di].status === 'running') {
              updateReasoningStep(currentSteps[di].id, { status: 'success' });
            }
          }
          currentStreamText = (currentStreamText || '').replace(/Token usage:.*(?:\n|$)/g, '').trim();
          if (currentStreamEl && currentStreamText) {
            clearTimeout(renderTimeout);
            renderTimeout = null;
            var contentEl = currentStreamEl.querySelector('.msg-content');
            if (contentEl) contentEl.innerHTML = renderMarkdown(currentStreamText);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            // Usage is shown via transformThinkingToUsage
            // Auto-execute /goto-reload or /goto commands found in assistant response
            // Scan currentStreamText AND recent assistant/tool bubbles
            var allTextsToScan = [];
            if (currentStreamText) allTextsToScan.push(currentStreamText);
            var allMsgs = chatMessages.querySelectorAll('.chatbot-message:not(.chatbot-message-user)');
            console.log('[goto-detect] scanning', allMsgs.length, 'messages, currentStreamText length:', (currentStreamText || '').length);
            for (var mi = allMsgs.length - 1; mi >= Math.max(0, allMsgs.length - 5); mi--) {
              var msgContent = allMsgs[mi].querySelector('.msg-content');
              var msgText = msgContent ? msgContent.textContent || '' : allMsgs[mi].textContent || '';
              allTextsToScan.push(msgText);
            }
            var found = false;
            for (var ti = 0; ti < allTextsToScan.length && !found; ti++) {
              var scanText = allTextsToScan[ti];
              var msgLines = scanText.split('\n');
              for (var di = msgLines.length - 1; di >= 0; di--) {
                // Aggressively clean: strip backticks, non-printable chars, trim
                var doneLine = msgLines[di].replace(/[^\x20-\x7E]/g, '').trim().replace(/^`+|`+$/g, '').trim();
                if (doneLine.startsWith('/')) console.log('[goto-detect] found command line:', JSON.stringify(doneLine));
                if (doneLine.startsWith('/goto-reload ') || doneLine.startsWith('/goto ')) {
                  // Parse flags: /goto --dtl Name, /goto --rule Name, /goto --bpl Name, /goto --trace
                  var isReloadVariant = doneLine.startsWith('/goto-reload ');
                  var gotoRest = doneLine.substring(isReloadVariant ? 13 : 6).trim().replace(/`/g, '').replace(/[.,;:!?`]+$/, '').trim();
                  var gotoEditor = null;
                  var gotoTarget = gotoRest;
                  if (gotoRest.startsWith('--dtl ')) { gotoEditor = 'dtl'; gotoTarget = gotoRest.substring(6).trim(); }
                  else if (gotoRest.startsWith('--rule ')) { gotoEditor = 'rule'; gotoTarget = gotoRest.substring(7).trim(); }
                  else if (gotoRest.startsWith('--bpl ')) { gotoEditor = 'bpl'; gotoTarget = gotoRest.substring(6).trim(); }
                  else if (gotoRest.startsWith('--production ')) { gotoEditor = 'production'; gotoTarget = gotoRest.substring(13).trim(); }
                  else if (gotoRest === '--trace' || gotoRest.startsWith('--trace ')) { gotoEditor = 'trace'; gotoTarget = gotoRest.substring(7).trim() || null; }
                  if (gotoTarget || gotoEditor === 'trace') {
                    console.log('[goto-detect] executing goto:', gotoTarget, 'editor:', gotoEditor);
                    (function(t, e) {
                      setTimeout(function() { executeGoto(t, e); }, 500);
                    })(gotoTarget, gotoEditor);
                  }
                  found = true;
                  break;
                } else if (doneLine === '/reload' || doneLine === '/refresh') {
                  sessionStorage.setItem('chatbot-programmatic-reload', 'true');
                  saveState();
                  setTimeout(function() { window.location.reload(); }, 500);
                  found = true;
                  break;
                }
              }
            }
          }
          currentStreamEl = null;
          currentStreamWrap = null;
          currentStreamText = '';
          currentThinkingEl = null;
          currentThinkingText = '';
          lastAssistantMsg = null;
          queryStartTime = null;
          collapseReasoningSteps();
          resetReasoningSteps();
          saveState();
          processQueue();
          break;
      }
    }

    // Mock streaming: animate text in 5-char chunks with 8ms delay
    async function animateText(targetEl, text, scrollEl, prefix) {
      // Split into special blocks (tables, quick_replies) and regular text
      var parts = text.split(/(\n(?:\|.*\|(?:\n|$))+|:::[\s\S]*?:::)/g);
      var accumulated = prefix ? prefix + '\n\n' : '';
      for (var pi = 0; pi < parts.length; pi++) {
        var part = parts[pi];
        if (!part) continue;
        if (part.startsWith('|') || part.startsWith(':::')) {
          accumulated += part;
          targetEl.innerHTML = renderMarkdownWithQuickReplies(accumulated);
          if (scrollEl) scrollEl.scrollTop = scrollEl.scrollHeight;
          await new Promise(function(r) { setTimeout(r, 50); });
        } else {
          var chunks = part.match(/[\s\S]{1,5}/g) || [];
          for (var ci = 0; ci < chunks.length; ci++) {
                accumulated += chunks[ci];
            targetEl.innerHTML = renderMarkdownWithQuickReplies(accumulated);
            if (scrollEl) scrollEl.scrollTop = scrollEl.scrollHeight;
            await new Promise(function(r) { setTimeout(r, 8); });
          }
        }
      }
      // Final render
      targetEl.innerHTML = renderMarkdownWithQuickReplies(accumulated);
      if (scrollEl) scrollEl.scrollTop = scrollEl.scrollHeight;
    }

    function renderMarkdownWithQuickReplies(text) {
      // Extract :::quick_replies blocks
      var qrRegex = /:::quick_replies\n(\[.*?\])\n:::/gs;
      var html = '';
      var lastIdx = 0;
      var match;
      var temp = text;
      // Simple split approach
      var parts = temp.split(/:::quick_replies\n/);
      if (parts.length === 1) return renderMarkdown(text);
      html = renderMarkdown(parts[0]).replace(/(<br\s*\/?>\s*)+$/, '');
      for (var i = 1; i < parts.length; i++) {
        var endIdx = parts[i].indexOf('\n:::');
        if (endIdx === -1) {
          // Incomplete block, render as text
          html += renderMarkdown(parts[i]);
        } else {
          var jsonStr = parts[i].substring(0, endIdx);
          var rest = parts[i].substring(endIdx + 4);
          try {
            var replies = JSON.parse(jsonStr);
            html += '<div class="quick-replies">';
            for (var ri = 0; ri < replies.length; ri++) {
              html += '<button class="quick-reply-btn" onclick="sendQuickReply(this.textContent)">' + escapeHtml(replies[ri]) + '</button>';
            }
            html += '</div>';
          } catch(e) {
            html += renderMarkdown(jsonStr);
          }
          if (rest.trim()) html += renderMarkdown(rest);
        }
      }
      return html;
    }

