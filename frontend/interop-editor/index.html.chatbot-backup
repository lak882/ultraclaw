      }

      // Step 3: Find and click component directly in the DOM
      var found = findAndClickComponent(componentName);
      if (found) {
        addMessage('system', 'Navigated to ' + componentName);
        saveState();
      } else {
        // Component not in DOM — namespace bounce to force Angular to re-fetch
        console.log('[goto] Component not found in DOM, trying namespace bounce...');
        namespaceBounce(function(bounced) {
          if (bounced) {
            // Re-open the editor panel after bounce
            var expandXpath2 = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[1]/div[2]/mat-icon/svg';
            xpathClick(expandXpath2);
            var dropdownBase2 = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[2]';
            try {
              var r2 = document.evaluate(dropdownBase2, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
              var dd2 = r2.singleNodeValue;
              if (dd2) {
                for (var di2 = 0; di2 < dd2.children.length; di2++) {
                  if (dd2.children[di2].textContent.trim().toLowerCase() === 'open full') { dd2.children[di2].click(); break; }
                }
              }
            } catch(e) {}

            // Poll for component to appear
            var attempts = 0;
            var poll = setInterval(function() {
              attempts++;
              var found2 = findAndClickComponent(componentName);
              if (found2 || attempts >= 20) {
                clearInterval(poll);
                if (found2) {
                  addMessage('system', 'Navigated to ' + componentName);
