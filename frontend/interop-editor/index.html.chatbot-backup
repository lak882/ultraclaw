      // Fallback: try svgicon="panel"
      if (!panelIcon) {
        panelIcon = document.querySelector('mat-icon[svgicon="panel"]');
      }

      if (!panelIcon) {
        console.log('[goto] Panel icon not found');
        return false;
      }
      console.log('[goto] Clicking panel icon to open menu');
      panelIcon.click();

      // Step 2: Wait for menu, then click "Open Full" using XPath:
      // /html/body/app-root/div[2]/app-dashboard/div[1]/div[3]/div[2]/div[3]
      // Note: the menu renders in a different part of the DOM (div[1] not div[2]).
      setTimeout(function() {
        var openFullItem = null;

        // Try exact XPath first
        try {
          var result = document.evaluate(
            '/html/body/app-root/div[2]/app-dashboard/div[1]/div[3]/div[2]/div[3]',
            document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null
          );
          openFullItem = result.singleNodeValue;
        } catch(e) {
          console.log('[goto] XPath lookup for Open Full failed:', e);
        }

        // Fallback 1: by svgicon attribute
        if (!openFullItem) {
          var openFullIcon = document.querySelector('mat-icon[svgicon="openFull"]');
          if (openFullIcon) {
            openFullItem = openFullIcon.closest('.paneMenuItem') || openFullIcon.parentElement;
          }
        }

        // Fallback 2: by text content
        if (!openFullItem) {
          var items = document.querySelectorAll('.paneMenuItem');
          for (var i = 0; i < items.length; i++) {
            if (items[i].textContent.trim().indexOf('Open Full') !== -1) {
              openFullItem = items[i];
              break;
            }
          }
        }

        if (openFullItem) {
          console.log('[goto] Clicking "Open Full" menu item');
          openFullItem.click();
        } else {
          // Undo panel click if menu didn't appear
          console.log('[goto] "Open Full" menu not found — clicking panel icon again to undo toggle');
          panelIcon.click();
        }
      }, 25);

      return true;
    }

    function resolveAndGoto(query) {
      addMessage('system', 'Resolving "' + query + '"...');
      updateStatus('Resolving...');
      var resolvePrompt = 'The user typed "/goto ' + query + '". Respond with ONLY the exact full class name of the production component they most likely mean. No explanation, no formatting, no quotes - just the class name like Package.SubPackage.ClassName';

      // Safety: auto-reset suppressAssistant after 15 seconds in case of stuck state
      var resolveTimeout = setTimeout(function() {
        if (suppressAssistant) {
          console.warn('[chatbot] Resolve timed out — resetting suppressAssistant');
          suppressAssistant = false;
          updateStatus('Connected');
        }
      }, 15000);

      fetch(apiBase + '/api/message', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({ session_id: sessionId, text: resolvePrompt, model: getSelectedModel() })
      }).then(function(res) {
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var responseText = '';

        // Suppress normal streaming display for this resolve request
        suppressAssistant = true;

        function read() {
          reader.read().then(function(result) {
            if (result.done) {
              clearTimeout(resolveTimeout);
              suppressAssistant = false;
              // Reset streaming state so next normal message renders fresh
              currentStreamEl = null;
              currentStreamText = '';
              currentThinkingEl = null;
              currentThinkingText = '';

              // Parse the resolved name and try goto again
              var resolved = responseText.trim().replace(/[`"']/g, '').trim();
              // Also strip any trailing periods or whitespace
              resolved = resolved.replace(/\.$/, '').trim();
              if (resolved && resolved.indexOf('.') !== -1 && resolved.length < 200) {
                addMessage('system', 'Resolved to: ' + resolved);
                // Try direct click with resolved name
                var found = findAndClickComponent(resolved);
                if (found) {
                  addMessage('system', 'Navigated to ' + resolved);
                  if (shouldExpandOnGoto(resolved)) {
                    setTimeout(function() { clickExpandIcon(); }, 25);
                  }
                  saveState();
                } else {
                  // Not in DOM — show error (use /goto-reload if a reload is needed)
                  addMessage('system', 'Could not find component: ' + resolved);
                  saveState();
                }
              } else {
                addMessage('system', 'Could not resolve component name from: ' + responseText.trim());
                saveState();
              }
