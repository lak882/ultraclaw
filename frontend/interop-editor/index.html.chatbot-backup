            console.log('[goto] Namespace bounce failed, falling back to soft reload');
            softReloadAndClick(componentName, editorType);
          }
        });
      }
    }

    function navigatePackageBrowser(componentName, colViewBase, divIndex) {
      // Split component name into package parts: e.g. "ElRio.POC.DTL.MyTransform" -> ["ElRio", "POC", "DTL", "MyTransform"]
      var parts = componentName.replace(/\.cls$/i, '').split('.');
      var partIndex = 0;
      var closeXpath = '/html/body/div[' + divIndex + ']/div[2]/div/mat-dialog-container/div/div/interop-package-browser-modal/div[1]/mat-icon';

      function closeModal() {
        // Close immediately — no delay
        xpathClick(closeXpath);
        document.body.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', code: 'Escape', keyCode: 27, which: 27, bubbles: true }));
        console.log('[goto] Closed modal');
      }

      function clickNextPart() {
        if (partIndex >= parts.length) {
          addMessage('system', 'Navigated to ' + componentName);
          closeModal();
          return;
        }
        var target = parts[partIndex];
        var colIndex = partIndex + 1; // XPath is 1-indexed
        var colXpath = colViewBase + '/div[' + colIndex + ']';
        var colEl = null;
        try {
          var result = document.evaluate(colXpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
          colEl = result.singleNodeValue;
        } catch(e) {
          console.log('[goto] Column XPath failed:', colXpath, e);
        }

        if (!colEl) {
          console.log('[goto] Column ' + colIndex + ' not found');
          addMessage('system', 'Could not find column ' + colIndex + ' for "' + target + '" in package browser');
          closeModal();
          return;
        }

        // Search within this column for the target item
        // Column structure: div/div[2]/div[N]/div — div[2] is the item list, div[N] is each row, inner div is clickable
        var itemList = colEl.querySelector('div > div:nth-child(2)');
        var rows = itemList ? itemList.children : [];
        var clicked = false;
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var clickTarget = row.querySelector('div') || row;
          var text = clickTarget.textContent.trim();
          console.log('[goto] Column ' + colIndex + ' item: "' + text + '"');
          // Match exact name, or name.cls for the final part
          if (text === target || (partIndex === parts.length - 1 && (text === target + '.cls' || text === componentName + '.cls'))) {
            console.log('[goto] Clicking "' + text + '" in column ' + colIndex);
            clickTarget.click();
            clicked = true;
            partIndex++;
            clickNextPart();
            break;
          }
        }
        if (!clicked) {
          console.log('[goto] Could not find "' + target + '" in column ' + colIndex);
          addMessage('system', 'Could not find "' + target + '" in package browser (column ' + colIndex + ')');
          closeModal();
        }
      }
      clickNextPart();
    }

    function checkPendingClick() {
