    function updateStepsVisibility() {
      if (!currentStepsListEl) return;
      var steps = currentStepsListEl.querySelectorAll('.reasoning-step');
      var total = steps.length;
      var connector = currentStepsListEl.querySelector('.reasoning-connector');
      if (total <= MAX_VISIBLE_STEPS || stepsExpandedAll) {
        for (var i = 0; i < steps.length; i++) { steps[i].style.display = ''; steps[i].classList.remove('last-visible'); }
        var btn = currentStepsListEl.querySelector('.reasoning-more-btn');
        if (btn) btn.remove();
