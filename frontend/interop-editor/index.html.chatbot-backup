          labelEl.classList.add('clickable');
          labelEl.style.cursor = 'pointer';
        }
        if (labelEl && !labelEl._clickBound) {
          labelEl._clickBound = true;
          labelEl.onclick = function() { toggleStepContent(stepId); };
        }
      }
    }

