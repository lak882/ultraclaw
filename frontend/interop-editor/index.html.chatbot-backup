    // ===== Namespace Bounce v2: querySelector-based, no XPath dependencies =====
    // Switches to another namespace and back to force Angular to re-fetch class lists.
    // Hidden behind a frozen DOM clone — invisible to the user (~500ms).
    function namespaceBounce(callback) {
      var ns = ((document.querySelector('[class*="namespace"]') || {}).textContent || '').trim();
      _isBouncingNamespace = true;
      // Wrap callback to always clear the bounce flag and restore namespace tracking
      var _origCallback = callback;
      callback = function(result) {
        _isBouncingNamespace = false;
        currentNamespace = detectNamespace();
        _origCallback(result);
      };
      if (!ns) {
        var m = window.location.search.match(/\$NAMESPACE=([^&]+)/i);
        ns = m ? decodeURIComponent(m[1]) : null;
      }
      if (!ns) { console.log('[bounce] No namespace found'); callback(false); return; }

      // Find namespace button by text content in toolbar
      var toolbarBtns = document.querySelectorAll('fr-topbar button, mat-toolbar button, header button');
      var nsBtn = null;
      for (var i = 0; i < toolbarBtns.length; i++) {
        if (toolbarBtns[i].textContent.trim().toUpperCase().indexOf(ns.toUpperCase()) !== -1) { nsBtn = toolbarBtns[i]; break; }
      }
      if (!nsBtn) { console.log('[bounce] No namespace button found'); callback(false); return; }

      // FREEZE: white blocker + DOM clone snapshot
      var blocker = document.createElement('div');
      blocker.id = 'ns-bounce-blocker';
      blocker.style.cssText = 'position:fixed;top:0;left:0;right:var(--chatbot-width,25vw);bottom:0;z-index:99998;background:white;';
      document.body.appendChild(blocker);

      var appRoot = document.querySelector('app-root');
      var clone = appRoot.cloneNode(true);
      clone.id = 'ns-bounce-snapshot';
      clone.style.cssText = appRoot.style.cssText + ';position:fixed;top:0;left:0;right:var(--chatbot-width,25vw);bottom:0;z-index:99999;pointer-events:none;overflow:hidden;';
      document.body.appendChild(clone);

      var cdkOverlay = document.querySelector('.cdk-overlay-container');
      if (cdkOverlay) cdkOverlay.style.display = 'none';

      function unfreeze() {
        var snap = document.getElementById('ns-bounce-snapshot');
        if (snap) snap.remove();
        var blk = document.getElementById('ns-bounce-blocker');
        if (blk) blk.remove();
        if (cdkOverlay) cdkOverlay.style.display = '';
      }

      // Wait for freeze to paint, then bounce behind it
      requestAnimationFrame(function() {
        requestAnimationFrame(function() {
          nsBtn.click();
          setTimeout(function() {
            var overlayBtns = document.querySelectorAll('.cdk-overlay-container button, .cdk-overlay-pane button');
            var otherBtn = null;
            for (var j = 0; j < overlayBtns.length; j++) {
              var t = overlayBtns[j].textContent.trim().toUpperCase();
              if (t && t !== ns.toUpperCase() && t.length < 30) { otherBtn = overlayBtns[j]; break; }
            }
            if (!otherBtn) { unfreeze(); console.log('[bounce] No other namespace found'); callback(false); return; }
            otherBtn.click();
            setTimeout(function() {
              nsBtn.click();
              setTimeout(function() {
                var overlayBtns2 = document.querySelectorAll('.cdk-overlay-container button, .cdk-overlay-pane button');
                var switched = false;
                for (var k = 0; k < overlayBtns2.length; k++) {
                  if (overlayBtns2[k].textContent.trim().toUpperCase() === ns.toUpperCase()) {
                    overlayBtns2[k].click();
                    switched = true;
                    break;
                  }
                }
                setTimeout(function() {
                  unfreeze();
                  console.log('[bounce] Namespace bounce complete, switched back:', switched);
                  callback(switched);
                }, 100);
              }, 100);
            }, 100);
          }, 100);
        });
      });
    }

    /** Shared goto logic used by /goto, /goto-reload, and the done-handler.
     *  Finds the component in the DOM, expands if appropriate, or falls back
     *  to resolveAndGoto when a session is available. */
    function xpathClick(xpath) {
      try {
        var result = document.evaluate(xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
        var el = result.singleNodeValue;
        if (el) { el.click(); return true; }
      } catch(e) { console.log('[goto] XPath failed:', xpath, e); }
      return false;
    }

    function executeGoto(componentName, editorType) {
      // Editor type -> sidebar panel div index
      var panelMap = { 'production': 1, 'rule': 2, 'dtl': 3, 'bpl': 4, 'trace': 5 };

      // Auto-detect editor type from component name if not specified
      if (!editorType && componentName) {
        var nameLower = componentName.toLowerCase();
        if (nameLower.indexOf('.dtl.') !== -1) editorType = 'dtl';
        else if (nameLower.indexOf('.rule.') !== -1 || nameLower.endsWith('routingrule')) editorType = 'rule';
        else if (nameLower.indexOf('.bpl.') !== -1) editorType = 'bpl';
        else if (nameLower.endsWith('.production')) editorType = 'production';
      }

      // Handle --trace: open Visual Trace in old UI in a new tab
      if (editorType === 'trace') {
        var ns = detectNamespace() || 'HSLIB';
        var cspBase = window.location.origin + '/csp/healthshare/' + ns.toLowerCase();
        if (componentName) {
          // Session ID provided — open directly
          window.open(cspBase + '/EnsPortal.VisualTrace.zen?SESSIONID=' + encodeURIComponent(componentName) + '&$NAMESPACE=' + ns, '_blank');
          addMessage('system', 'Opened trace for session ' + componentName);
        } else {
          // Fetch latest session ID via Atelier SQL endpoint
          addMessage('system', 'Fetching latest trace...');
          var atelierBase = window.location.origin + '/irishealth/api/atelier/v8/' + ns.toLowerCase();
          fetch(atelierBase + '?action=query', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Basic ' + btoa('superuser:SYS') },
            body: JSON.stringify({ query: 'SELECT TOP 1 SessionId FROM Ens.MessageHeader ORDER BY ID DESC' })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            var rows = (data.result || {}).content || [];
            if (rows.length > 0 && rows[0].SessionId) {
              var sid = rows[0].SessionId;
              window.open(cspBase + '/EnsPortal.VisualTrace.zen?SESSIONID=' + sid + '&$NAMESPACE=' + ns, '_blank');
              addMessage('system', 'Opened trace for session ' + sid);
            } else {
              // No messages — fall back to Message Viewer
              window.open(cspBase + '/EnsPortal.MessageViewer.zen?$NAMESPACE=' + ns, '_blank');
              addMessage('system', 'No messages found — opened Message Viewer');
            }
            saveState();
          })
          .catch(function() {
            // Query failed — open Message Viewer as fallback
            window.open(cspBase + '/EnsPortal.MessageViewer.zen?$NAMESPACE=' + ns, '_blank');
            addMessage('system', 'Opened Message Viewer in new tab');
            saveState();
          });
        }
        return;
      }

      // Handle --production: click sidebar icon + Open Full, or URL redirect for net-new
      if (editorType === 'production') {
        var prodIconXpath = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[1]/div/div[2]/mat-icon/svg';
        xpathClick(prodIconXpath);
        // Try "Open Full" from dropdown
        var prodDropdown = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[1]/div[2]';
        var prodDropdownEl = null;
        try {
          var r = document.evaluate(prodDropdown, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
          prodDropdownEl = r.singleNodeValue;
        } catch(e) {}
        var opened = false;
        if (prodDropdownEl) {
          var items = prodDropdownEl.children;
          for (var di = 0; di < items.length; di++) {
            if (items[di].textContent.trim().toLowerCase() === 'open full') {
              items[di].click();
              opened = true;
              break;
            }
          }
        }
        if (opened) {
          addMessage('system', 'Opened production' + (componentName ? ' ' + componentName : ''));
        } else if (componentName) {
          // Net-new production not in sidebar yet — reload with $PRODUCTION param
          var url = new URL(window.location.href);
          url.searchParams.set('$PRODUCTION', componentName);
          addMessage('system', 'New production — reloading with ' + componentName + '...');
          saveState();
          sessionStorage.setItem('chatbot-programmatic-reload', 'true');
          window.location.href = url.toString();
          return;
        }
        saveState();
        return;
      }

      var panelIndex = panelMap[editorType] || 3; // default to DTL

      // Step 1: Click sidebar icon
      var expandXpath = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[1]/div[2]/mat-icon/svg';
      xpathClick(expandXpath);

      // Step 2: Click "Open Full" by text — NEVER click bare "Open"
      var dropdownBase = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[2]';
      var dropdownEl = null;
      try {
        var r = document.evaluate(dropdownBase, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
