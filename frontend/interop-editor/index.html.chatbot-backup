  background:var(--fr-styles-color-dark-grey, rgba(0,0,0,.4));height:48px;
}

/* Drag overlay — captures all mouse events during resize, prevents jank */
.drag-overlay{
  display:none;
  position:fixed;inset:0;
  z-index:9999;
  cursor:ew-resize;
}
body.chatbot-dragging .drag-overlay{display:block}
body.chatbot-dragging app-root{pointer-events:none}

/* Toolbar - match production config header:
   white bg, 4px primary border-top, 40px content height, 1px border-bottom (matches .toolbar in Angular app),
   near-black text, xs font-size, .05rem letter-spacing */
.chatbot-toolbar{
  background:white;
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  padding:0 16px;
  display:flex;justify-content:space-between;align-items:center;
  height:39px;
  min-height:39px;
  border-top:var(--fr-header-border-top-toolbar, 4px) solid var(--fr-styles-color-primary);
  border-bottom:2px solid rgba(0,0,0,.1215686275);
  box-shadow:none;
  box-sizing:content-box;
  position:relative;
  z-index:1;
  margin:0;
}
.token-counter{
  display:flex;align-items:center;gap:3px;
  font-size:11px;color:#bbb;font-weight:400;
  letter-spacing:normal;
  font-family:'Noto Sans Mono',Consolas,monospace;
  white-space:nowrap;transition:opacity 0.3s;
}
.chatbot-toolbar-title{
  display:flex;align-items:center;gap:8px;
  font-family:var(--mat-toolbar-title-text-font, 'Noto Sans','Noto Sans Arabic',Arial,sans-serif);
  font-size:var(--fr-header-font-size-top-bar-xs, var(--fr-styles-font-size-xs, .8125rem));
  font-weight:600;
  line-height:var(--mat-toolbar-title-text-line-height, 1.25rem);
  letter-spacing:normal;
}

/* Close button - matches toolbarIconLink: 29x29px, very-dark-grey icon color */
.chatbot-close{
  background:none;border:none;
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  font-size:16px;cursor:pointer;
  padding:0;line-height:1;
  border-radius:50%;
  transition:background 0.2s ease;
  width:29px;height:29px;
  display:flex;align-items:center;justify-content:center;
}
.chatbot-close:hover{background:rgba(0,0,0,.08)}
.chatbot-close:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:-2px;border-radius:50%}

/* Status bar */
.chatbot-status{
  display:none !important;
}
.chatbot-status-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--fr-styles-color-secondary);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}@keyframes chatbot-logo-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:0.5;transform:scale(0.95)}}

/* Message area - matches mat-sidenav-content background */
.chatbot-content{
  flex:1;padding:12px;overflow-y:auto;scroll-behavior:smooth;
  background:white;
  display:flex;flex-direction:column;gap:12px;
  align-items:center;
}
.chatbot-content > *{
  width:100%;max-width:672px;
}
/* Scrollbar - matches the app global scrollbar */
/* Thin scrollbar (from rht-demo nextjs) */
#chatbot-sidebar *::-webkit-scrollbar{ width:4px;height:4px; }
#chatbot-sidebar *::-webkit-scrollbar-track{ background:transparent; }
#chatbot-sidebar *::-webkit-scrollbar-thumb{ background:rgba(0,0,0,.15);border-radius:4px; }
#chatbot-sidebar *::-webkit-scrollbar-thumb:hover{ background:rgba(0,0,0,.3); }

/* Messages — each message is a flex child of the column-flex .chatbot-content */
.chatbot-message{
  background:transparent;
  border:none;
  padding:8px 4px;
  border-radius:0;
  box-shadow:none;
  font-size:var(--chatbot-font-size);
  line-height:1.6;
  color:rgba(0,0,0,.87);
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  word-break:break-word;
  max-width:88%;
  width:88%;
  align-self:flex-start;
  display:flex;
  flex-direction:column;
}
.chatbot-message .bubble-thinking-bar{ order:3; }
.chatbot-message .bubble-usage-bar{ order:3; }
/* Code blocks and tables inside bubbles */
.chatbot-message .chatbot-codeblock,
.chatbot-message .msg-content .chatbot-codeblock{
  max-width:100%;
  box-sizing:border-box;
  overflow-x:auto;
}
.chatbot-message .chatbot-table,
.chatbot-message .msg-content .chatbot-table{
  max-width:100%;
}
/* User messages — right-aligned, subtle grey bubble */
.chatbot-message-user{
  background:#f0f0f0;
  color:var(--fr-styles-color-near-black, #2b2b2b);
  border:none;
  border-radius:18px;
  padding:8px 14px;
  align-self:flex-end;
  max-width:85%;
  width:fit-content;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
/* System messages — centered, subtle, no bubble */
.chatbot-message-system{
  background:transparent;
  color:rgba(0,0,0,.54);
  font-size:var(--fr-styles-font-size-xs);
  padding:4px 8px;
  box-shadow:none;
  border:none;
  border-radius:0;
  max-width:100%;
  width:auto;
  align-self:center;
  text-align:center;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
/* Tool messages now rendered inside reasoning steps */
/* Error messages */
.chatbot-message-error{
  background:var(--fr-styles-color-alert-error-fill, #ffebee);
  color:var(--fr-styles-color-alert-error-border, #c62828);
  border-left:3px solid var(--fr-styles-color-alert-error-border, #c62828);
  border-radius:4px;
  border-top:none;
  border-right:none;
  border-bottom:none;
}

/* Input area */
.chatbot-input-container{
  position:relative;
  padding:12px 16px;
  border-top:none;
  background:white;
  display:flex;flex-direction:column;align-items:center;
}
.chatbot-input-container > *{
  width:100%;max-width:672px;
}
.chatbot-input-wrapper{
  display:flex;flex-direction:column;gap:4px;
  border:1px solid #e5e5e5;background:#fff;
  padding:8px;border-radius:16px;
  transition:border-radius 0.2s ease,border-color 0.15s;
}
.chatbot-input-wrapper.expanded{ border-radius:16px; }
.chatbot-input-wrapper:focus-within{ border-color:rgba(0,0,0,0.25); }
.chatbot-input-row{
  display:flex;align-items:flex-end;
}
.chatbot-typeahead{
  display:none;
  position:absolute;
  bottom:100%;
  left:0;right:0;
  background:white;
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-bottom:none;
  border-radius:4px 4px 0 0;
  max-height:200px;
  overflow-y:auto;
  z-index:10;
  box-shadow:0 -2px 8px rgba(0,0,0,.1);
}
.chatbot-typeahead-item{
  padding:6px 12px;
  cursor:pointer;
  display:flex;
  gap:8px;
  align-items:baseline;
  font-size:var(--chatbot-font-size);
  border-bottom:1px solid var(--fr-styles-color-very-light-grey, #f2f2f2);
}
.chatbot-typeahead-item:hover,
.chatbot-typeahead-item.active{
  background:var(--fr-styles-color-very-light-grey, #f5f5f5);
}
.chatbot-typeahead-cmd{
  font-weight:600;
  color:var(--fr-styles-color-primary);
  white-space:nowrap;
  font-family:'Noto Sans Mono',Consolas,monospace;
}
.chatbot-typeahead-desc{
  color:var(--fr-styles-color-dark-grey);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.chatbot-input{
  flex:1;resize:none;border:none;background:transparent;
  padding:4px 8px;font-size:14px;line-height:20px;
  outline:none !important;min-height:20px;max-height:120px;transition:height 0.15s ease;
  overflow-y:hidden;font-family:inherit;
  color:rgba(0,0,0,.87);box-sizing:border-box;
  box-shadow:none !important;
}
.chatbot-input:focus{ outline:none !important;border:none !important;box-shadow:none !important; }
.chatbot-input::placeholder{ color:#aaa; }
.chatbot-input:disabled{ cursor:not-allowed;opacity:0.5; }


.chatbot-input-bottom{
  display:flex;align-items:center;gap:4px;
  padding:2px 4px 0;
}

.chatbot-send-btn{
  display:flex;width:28px;height:28px;flex-shrink:0;
  align-items:center;justify-content:center;
  border-radius:50%;border:none;font-size:16px;
  cursor:not-allowed;background:#f5f5f5;color:#999;
  transition:background 0.15s,color 0.15s;padding:0;
}
.chatbot-send-btn.active{
  cursor:pointer;background:#111;color:#fff;
}
.chatbot-send-btn.active:hover{ background:#333; }
.chatbot-send-btn:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px}
.chatbot-stop-btn{background:#111 !important;color:#fff !important;cursor:pointer !important;margin-left:auto}
.chatbot-stop-btn:hover{background:#333 !important}

/* Custom model selector dropdown */
.chatbot-model-selector{position:relative}
.chatbot-model-ghost{
  background:none;border:none;
  padding:0;
  font-size:inherit;font-weight:inherit;
  color:inherit;letter-spacing:inherit;
  cursor:pointer;font-family:inherit;
  display:flex;align-items:center;gap:4px;
  transition:opacity 0.15s ease;
  white-space:nowrap;line-height:inherit;
}
.chatbot-model-ghost:hover{ opacity:0.7; }
.chatbot-model-ghost:focus{ outline:none !important; }
.chatbot-model-ghost svg{ flex-shrink:0;opacity:0.5; }
.chatbot-model-dropdown{
  display:none;
  position:absolute;top:100%;left:0;
  margin-top:8px;
  background:white;
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:8px;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
  min-width:200px;
  z-index:20;
  overflow:hidden;
}
.chatbot-model-dropdown.open{display:block}
.chatbot-model-option{
  padding:6px 10px;cursor:pointer;
  transition:background 0.1s ease;
}
.chatbot-model-option:hover{background:var(--fr-styles-color-very-light-grey, #f5f5f5)}
.chatbot-model-option.selected{background:var(--fr-styles-color-very-light-grey, #f5f5f5)}
.chatbot-model-option .model-name{
  display:block;font-size:13px;
  font-weight:600;color:var(--fr-styles-color-near-black);
}
.chatbot-model-option .model-desc{
  display:block;font-size:11px;
  color:var(--fr-styles-color-dark-grey);margin-top:0;
}

/* Toggle button - subtle pill matching toolbar icon style */
#chatbot-toggle{
  position:fixed;bottom:12px;right:22px;
  height:30px;
  padding:0 12px;
  border-radius:4px;
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  border:1px solid var(--mat-divider-color, rgba(0,0,0,.12));
  cursor:pointer;
  z-index:10001;
  box-shadow:0 2px 4px -1px #0003,0 4px 5px #00000024,0 1px 10px #0000001f;
  font-size:var(--fr-styles-font-size-xs);
  font-weight:600;
  letter-spacing:.05rem;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  display:none;align-items:center;justify-content:center;gap:6px;
  transition:background 0.2s ease,box-shadow 0.2s ease,border-color 0.2s ease;
}
#chatbot-toggle:hover{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border-color:rgba(0,0,0,.24);
  box-shadow:0 3px 5px -1px #0003,0 6px 10px #00000024,0 1px 18px #0000001f;
}
#chatbot-toggle:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px}
body.chatbot-closed #chatbot-toggle{display:flex}

/* Hide chatbot entirely when user is not authenticated (login page visible) */
body.chatbot-auth-hidden #chatbot-sidebar{display:none !important}
body.chatbot-auth-hidden #chatbot-toggle{display:none !important}
body.chatbot-auth-hidden app-root{right:0 !important}

.chatbot-upload-btn{
  display:flex;align-items:center;justify-content:center;
  width:28px;height:28px;border-radius:50%;
  border:none;background:none;color:#888;
  cursor:pointer;font-size:14px;
  transition:color 0.15s;flex-shrink:0;
}
.chatbot-upload-btn:hover{ color:#111; }

/* File chips — before send (in input area) */
.chatbot-attachment-chip{
  position:relative;display:flex;align-items:center;gap:6px;
  height:40px;width:150px;flex-shrink:0;
  border-radius:7px;border:1px solid #e5e5e5;
  background:#fff;padding:0 8px;
}
.chatbot-attachment-chip .chip-icon{
  color:#888;flex-shrink:0;
  width:14px;height:14px;display:flex;align-items:center;justify-content:center;
}
.chatbot-attachment-chip .chip-icon svg{ width:14px;height:14px; }
.chatbot-attachment-chip .chip-info{
  display:flex;flex-direction:column;min-width:0;flex:1;
}
.chatbot-attachment-chip .chip-name{
  font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.chatbot-attachment-chip .chip-label{
  font-size:10px;color:#888;
}
.chatbot-attachment-remove{
  position:absolute;top:-4px;right:-4px;
  width:16px;height:16px;border-radius:50%;
  border:none;background:#e5e5e5;color:#444;
  font-size:10px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;opacity:0;transition:opacity 0.15s;padding:0;
}
.chatbot-attachment-chip:hover .chatbot-attachment-remove{ opacity:1; }
/* Sent file chips (in message, smaller, no remove) */
.sent-file-chips{
  display:flex;gap:6px;overflow-x:auto;padding:0 0 4px;
}
.sent-file-chip{
  display:flex;align-items:center;gap:6px;
  height:36px;width:110px;flex-shrink:0;
  border-radius:6px;border:1px solid #e5e5e5;
  padding:0 8px;background:white;
}
.sent-file-chip .chip-icon{ color:#888;flex-shrink:0;width:14px;height:14px;display:flex;align-items:center;justify-content:center; }
.sent-file-chip .chip-icon svg{ width:14px;height:14px; }
.sent-file-chip .chip-info{ display:flex;flex-direction:column;min-width:0;flex:1; }
.sent-file-chip .chip-name{ font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis; }
.sent-file-chip .chip-label{ font-size:10px;color:#888; }
.chatbot-attachments{
  display:flex;gap:8px;overflow-x:auto;
  padding:4px 4px;
  margin-bottom:8px;
}

/* Markdown rendering styles */
/* Markdown styles (matching rht-demo) */
.msg-content{ font-size:14px;line-height:1.6;word-break:break-word; }
.msg-content p{ margin:0 0 4px; }
.msg-content p:last-child{ margin-bottom:0; }
.msg-content h1,.msg-content h2,.msg-content h3,.msg-content h4{
  margin:12px 0 6px;font-weight:600;line-height:1.3;
}
.msg-content h1{ font-size:17px; }
.msg-content h2{ font-size:15px; }
.msg-content h3{ font-size:14px; }
.msg-content ul,.msg-content ol{ padding-left:20px;margin:4px 0 8px; }
.msg-content li{ margin-bottom:2px; }
.msg-content code{
  background:#f5f5f5;padding:1px 4px;border-radius:3px;font-size:12px;
  font-family:'Noto Sans Mono',Consolas,monospace;
}
.msg-content pre{
  background:#f5f5f5;padding:10px 12px;border-radius:6px;overflow-x:auto;
  margin:8px 0;
}
.msg-content pre code{ background:none;padding:0; }
.msg-content blockquote{
  border-left:3px solid #e5e5e5;margin:8px 0;padding:4px 12px;color:#666;
}
.msg-content table{ border-collapse:collapse;width:100%;margin:8px 0;font-size:12px; }
.msg-content th,.msg-content td{ border:1px solid #e5e5e5;padding:6px 10px;text-align:left; }
.msg-content th{ background:#f5f5f5;font-weight:600; }
.msg-content a{ color:#333;text-decoration:underline; }
.msg-content a:hover{ color:#555; }
.msg-content hr{ border:none;border-top:1px solid #e5e5e5;margin:12px 0; }
/* Quick reply buttons */
.quick-replies{
  display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;
}
.msg-content > *:has(+ .quick-replies){ margin-bottom:0 !important; }
.msg-content > br:has(+ .quick-replies){ display:none; }
.quick-reply-btn{
  padding:5px 12px;border:1px solid #d0d0d0;border-radius:16px;
  background:#fff;font-size:12px;font-family:inherit;
  cursor:pointer;transition:background 0.15s,border-color 0.15s;
}
.quick-reply-btn:hover{ background:#f5f5f5;border-color:#999; }
.msg-content strong{ font-weight:700; }
.msg-content em{ font-style:italic; }
/* Legacy class compat */
.chatbot-codeblock{
  background:#f5f5f5;border:none;border-radius:6px;
  padding:10px 12px;margin:8px 0;overflow-x:auto;
  font-family:'Noto Sans Mono',Consolas,monospace;
  font-size:12px;line-height:1.5;white-space:pre;
}
.chatbot-inline-code{
  background:#f5f5f5;border:none;border-radius:3px;
  padding:1px 4px;font-family:'Noto Sans Mono',Consolas,monospace;font-size:12px;
}
.chatbot-table{ border-collapse:collapse;width:max-content;min-width:50%;margin:8px 0;font-size:12px; }
.chatbot-table th,.chatbot-table td{ border:1px solid #e5e5e5;padding:6px 10px;text-align:left;max-width:300px;word-wrap:break-word; }
.chatbot-table th{ background:#f5f5f5;font-weight:600; }
.chatbot-hr{ border:none;border-top:1px solid #e5e5e5;margin:12px 0; }
/* Reasoning steps (ported from rht-demo) */
.reasoning-steps{ margin-bottom:8px; }
.reasoning-more-btn{
  display:flex;align-items:center;height:24px;
  font-size:11px;color:#bbb;
  cursor:pointer;background:white;border:none;padding:0 0 0 24px;
  font-family:inherit;transition:color 0.15s;
  position:relative;z-index:1;width:100%;
}
.reasoning-more-btn:hover{ color:#888; }
.reasoning-toggle{
  display:flex;align-items:center;gap:8px;
  font-size:var(--chatbot-font-size);color:#888;
  cursor:pointer;background:none;border:none;padding:0;margin-top:12px;margin-bottom:6px;
  font-family:inherit;outline:none;-webkit-tap-highlight-color:transparent;
}
.reasoning-toggle:focus,.reasoning-toggle:active{ outline:none;box-shadow:none;background:none; }
.reasoning-toggle .chevron-icon{
  display:inline-flex;transition:transform 0.2s;
  width:16px;height:16px;
}
.reasoning-toggle .chevron-icon.open{ transform:rotate(180deg); }
.reasoning-list{ position:relative; }
.reasoning-connector{
  position:absolute;left:8px;top:16px;bottom:16px;
  width:1px;background:#ccc;
}
.reasoning-step{ position:relative; }
.reasoning-step:last-child::before,.reasoning-step.last-visible::before{ content:'';position:absolute;left:8px;top:16px;bottom:0;width:1px;background:white;z-index:1; }
.reasoning-step-row{
  display:flex;align-items:center;gap:8px;height:32px;
}
.reasoning-step-icon{
  width:16px;height:16px;
  display:flex;align-items:center;justify-content:center;
  flex-shrink:0;position:relative;z-index:1;
}
.reasoning-dot{
  width:6px;height:6px;border-radius:50%;background:#888;position:relative;top:-2px;left:2px;
}
.reasoning-tool-icon{
  font-size:14px;color:#888;background:white;
  width:16px;height:16px;
  display:flex;align-items:center;justify-content:center;
}
.reasoning-step-label{
  flex:1;display:flex;align-items:center;gap:6px;
  font-size:var(--chatbot-font-size);color:#777;
  text-align:left;min-width:0;
  overflow:hidden;white-space:nowrap;text-overflow:ellipsis;
}
.reasoning-step-label.clickable{
  cursor:pointer;background:none;border:none;padding:0;width:100%;
  font-family:inherit;outline:none !important;
}
.reasoning-step-label > span:first-child{
  overflow:hidden;white-space:nowrap;text-overflow:ellipsis;display:block;flex:1;min-width:0;
}
.reasoning-step.done .reasoning-step-label{ color:#aaa; }
.reasoning-step.done .reasoning-tool-icon{ color:#aaa; }
.reasoning-chevron-step{
  display:inline-flex;flex-shrink:0;
  transition:transform 0.2s;width:12px;height:12px;
}
.reasoning-chevron-step.open{ transform:rotate(180deg); }
.reasoning-chevron-step.invisible{ visibility:hidden; }
.reasoning-result-count{
  font-size:11px;color:#bbb;flex-shrink:0;width:64px;text-align:right;
}
.reasoning-step-content{
  margin:4px 0 4px 24px;max-height:192px;overflow-y:auto;
}
.reasoning-thinking-content{
  color:rgba(136,136,136,0.7);font-size:12px;
}
.reasoning-thinking-content p{ margin:0 0 4px; }
.reasoning-tool-lines{ display:flex;flex-direction:column;gap:2px; }
.reasoning-tool-line{
  font-size:11px;color:rgba(136,136,136,0.7);
  font-family:'Noto Sans Mono',Consolas,monospace;word-break:break-all;
}
.reasoning-json-details{
  margin-top:8px;border-radius:6px;
  border:1px solid #eee;background:#f9f9f9;
}
.reasoning-json-details summary{
  cursor:pointer;padding:6px 10px;font-size:11px;font-weight:500;color:#888;
}
.reasoning-json-pre{
  border-top:1px solid #eee;padding:8px 10px;font-size:11px;
  max-height:256px;overflow:auto;white-space:pre-wrap;
  word-break:break-all;color:rgba(136,136,136,0.8);margin:0;
}
.reasoning-breathe{ animation:breathe 2.5s ease-in-out infinite; }
@keyframes breathe{ 0%,100%{opacity:1} 50%{opacity:0.4} }
@keyframes thinking-shimmer{ 0%{background-position:200% 0} 100%{background-position:-200% 0} }
.bubble-usage-bar{
  display:flex;align-items:center;gap:8px;padding:8px 0 6px 0;margin-top:6px;
}
.bubble-usage-bar .usage-icon{
  width:16px;height:16px;flex-shrink:0;opacity:1;
