    function openLatestTrace(sessionId) {
      if (sessionId) {
        addMessage('system', 'Opening trace for session ' + sessionId + '...');
      } else {
        addMessage('system', 'Opening latest trace...');
      }

      // Step 1: Click Message Viewer tab
      var found = false;
      var buttons = document.querySelectorAll('div[class*="navbutton"], div[class*="buttonTab"], .navbuttonText');
      for (var i = 0; i < buttons.length; i++) {
        if (buttons[i].textContent.trim().indexOf('Message Viewer') !== -1) {
          buttons[i].click();
          found = true;
          break;
        }
      }
      if (!found) {
        // Try broader search — leaf divs with exact text
        var allDivs = document.querySelectorAll('div');
        for (var i = 0; i < allDivs.length; i++) {
          if (allDivs[i].textContent.trim() === 'Message Viewer' && allDivs[i].children.length === 0) {
            allDivs[i].click();
            found = true;
            break;
          }
        }
      }
      if (!found) {
        addMessage('system', 'Could not find Message Viewer tab');
        return;
      }

      // Step 2: Wait for table to load, then find the right row
      setTimeout(function() {
        var targetRow = null;

        if (sessionId) {
          // Search all rows for one containing the session ID
          var rows = document.querySelectorAll('app-message-viewer table tbody tr, table tbody tr');
          for (var i = 0; i < rows.length; i++) {
            if (rows[i].textContent.indexOf(sessionId) !== -1) {
              targetRow = rows[i];
              break;
            }
          }
          if (!targetRow) {
            // Try partial match (user might give partial session ID)
            for (var i = 0; i < rows.length; i++) {
              var cells = rows[i].querySelectorAll('td');
              for (var j = 0; j < cells.length; j++) {
                if (cells[j].textContent.trim().indexOf(sessionId) !== -1) {
                  targetRow = rows[i];
                  break;
                }
              }
              if (targetRow) break;
            }
          }
          if (!targetRow) {
            addMessage('system', 'Could not find session ' + sessionId + ' in Message Viewer');
            return;
          }
        } else {
          // Default: first row (latest)
          targetRow = document.querySelector('app-message-viewer table tbody tr:first-child');
          if (!targetRow) {
            var allRows = document.querySelectorAll('table tbody tr');
            targetRow = allRows.length > 0 ? allRows[0] : null;
          }
        }

        if (!targetRow) {
          addMessage('system', 'No messages found in Message Viewer');
          return;
        }
        targetRow.click();

        // Step 3: Click visual trace cell in THAT row (5th column)
        setTimeout(function() {
          var traceCell = targetRow.querySelector('td:nth-child(5) div') || targetRow.querySelector('td:nth-child(5)');
          if (traceCell) {
            traceCell.click();
          }

          // Step 4: Open Full
          setTimeout(function() {
            clickExpandIcon();
            if (sessionId) {
              addMessage('system', 'Opened trace for session ' + sessionId);
            } else {
              addMessage('system', 'Opened latest trace');
            }
          }, 600);
        }, 500);
      }, 800);
    }

    function findAndClickComponent(name) {
