    function clickExpandIcon() {
      // Step 1: Find the panel icon using the specific DOM path from XPath:
      // /html/body/app-root/div[2]/app-dashboard/div[2]/interop-grid-cell/div/div/
      //   interop-grid-cell[2]/div/div/interop-grid-cell[2]/div/div[1]/div/div/mat-icon
      var panelIcon = null;

      // Try the exact XPath first
      try {
        var result = document.evaluate(
          '/html/body/app-root/div[2]/app-dashboard/div[2]/interop-grid-cell/div/div/interop-grid-cell[2]/div/div/interop-grid-cell[2]/div/div[1]/div/div/mat-icon',
          document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null
        );
        panelIcon = result.singleNodeValue;
      } catch(e) {
        console.log('[goto] XPath lookup for panel icon failed:', e);
