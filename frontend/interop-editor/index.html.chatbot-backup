    function detectNamespace() {
      // 1. Check URL path (most reliable after Angular navigation completes)
      var path = window.location.pathname;
      var match = path.match(/\/healthshare\/([^\/]+)/i);
      if (match) return match[1].toUpperCase();
      // 2. Check $NAMESPACE query parameter
      var params = new URLSearchParams(window.location.search);
      var ns = params.get('$NAMESPACE') || params.get('NAMESPACE');
      if (ns) return ns.toUpperCase();
      // 3. Check DOM toolbar element (catches Angular state before URL updates)
      var nsEl = document.querySelector('[class*="namespace"]');
      if (nsEl) {
        var text = nsEl.textContent.trim().toUpperCase();
        if (text && /^[A-Z][A-Z0-9_-]*$/.test(text)) return text;
      }
      return null;
    }

    // --- Namespace change detection ---
    // Track the current namespace so we can detect switches
    var currentNamespace = detectNamespace();
    // Flag to suppress namespace change detection during namespaceBounce()
    var _isBouncingNamespace = false;

    // Override history methods to catch Angular's client-side navigation
    (function() {
      var originalPushState = history.pushState;
      var originalReplaceState = history.replaceState;

      history.pushState = function() {
        originalPushState.apply(this, arguments);
        checkNamespaceChange();
      };

      history.replaceState = function() {
        originalReplaceState.apply(this, arguments);
        checkNamespaceChange();
      };

      // Also catch back/forward button navigation
      window.addEventListener('popstate', checkNamespaceChange);

      // Periodic fallback: some Angular navigations may not trigger
      // pushState/replaceState, so poll every 2 seconds
      setInterval(checkNamespaceChange, 2000);
    })();

    function checkNamespaceChange() {
      if (_isBouncingNamespace) return; // suppress during namespace bounce
      var newNamespace = detectNamespace();
      if (newNamespace && newNamespace !== currentNamespace) {
        currentNamespace = newNamespace;
        onNamespaceChanged(newNamespace);
      }
    }

    function onNamespaceChanged(namespace) {
      addMessage('system', 'Switched to namespace ' + namespace + '. Reconnecting...');
      // Re-initialize session with the new namespace so the backend context updates
      initSession();
    }

    // --- MutationObserver for immediate namespace dropdown detection ---
    // The Angular fr-topbar namespace dropdown may update the DOM before the URL changes.
    // Observe the topbar for text changes to detect namespace switches instantly.
    (function() {
      var observerStarted = false;
      function startNamespaceObserver() {
        if (observerStarted) return;
        var topbar = document.querySelector('fr-topbar') || document.querySelector('mat-toolbar');
        if (!topbar) return;
        observerStarted = true;
        var observer = new MutationObserver(function() {
          if (_isBouncingNamespace) return;
          checkNamespaceChange();
        });
        observer.observe(topbar, { childList: true, subtree: true, characterData: true });
      }
      // Try immediately and retry until the topbar is in the DOM
      startNamespaceObserver();
      var retryInterval = setInterval(function() {
        startNamespaceObserver();
        if (observerStarted) clearInterval(retryInterval);
      }, 1000);
      // Stop retrying after 30 seconds
      setTimeout(function() { clearInterval(retryInterval); }, 30000);
    })();

