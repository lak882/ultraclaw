    // Auto-resize textarea, typeahead, and Enter/Shift+Enter handling
    (function() {
      var chatInput = document.getElementById('chatbot-input');
      chatInput.addEventListener('input', function() {
        // Auto-resize + toggle pill shape together
        var wrapper = document.getElementById('chatbot-input-wrapper');
        this.style.transition = 'none'; // measure without transition
        this.style.height = 'auto';
        var scrollH = Math.min(this.scrollHeight, 120);
        var lineH = parseInt(getComputedStyle(this).lineHeight) || 20;
        var isMulti = this.scrollHeight > lineH * 1.5;
        if (wrapper) {
          if (isMulti) wrapper.classList.add('expanded');
          else wrapper.classList.remove('expanded');
        }
        this.style.height = scrollH + 'px';
        this.style.overflowY = this.scrollHeight > 120 ? 'auto' : 'hidden';
        // Update send button state
        updateSendButton();

        // Typeahead logic
        var val = this.value;
        if (val.startsWith('/')) {
          var query = val.toLowerCase();
          filteredCommands = slashCommands.filter(function(c) {
            return c.cmd.toLowerCase().indexOf(query) !== -1 ||
                   c.desc.toLowerCase().indexOf(query.substring(1)) !== -1;
          });
          showTypeahead(filteredCommands);
        } else {
          hideTypeahead();
        }
      });
      chatInput.addEventListener('keydown', function(e) {
        // Typeahead navigation
        if (typeaheadEl.style.display === 'block') {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            typeaheadIndex = Math.min(typeaheadIndex + 1, filteredCommands.length - 1);
            updateTypeaheadHighlight();
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            typeaheadIndex = Math.max(typeaheadIndex - 1, 0);
            updateTypeaheadHighlight();
            return;
          }
          if (e.key === 'Tab' || (e.key === 'Enter' && typeaheadIndex >= 0)) {
            e.preventDefault();
            if (typeaheadIndex >= 0) {
              selectTypeahead(typeaheadIndex);
            } else if (filteredCommands.length > 0) {
              selectTypeahead(0);
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            hideTypeahead();
            return;
          }
        }

        // Normal Enter to send (or stop if generating)
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          if (isGenerating) {
            stopGeneration();
          } else {
            sendMessage();
          }
