    // ===== /goto-test: test multiple strategies for refreshing the collection list =====
    function runGotoTest(strategiesStr, targetComponent) {
      var allStrategies = [1, 2, 3, 4, 5, 6];
      var strategies;
      if (strategiesStr === 'all') {
        strategies = allStrategies;
      } else {
        strategies = strategiesStr.split(',').map(function(s) { return parseInt(s.trim(), 10); }).filter(function(n) { return n >= 1 && n <= 6; });
      }
      if (strategies.length === 0) {
        addMessage('system', 'No valid strategies. Use 1-6 or "all". Example: /goto-test 1,3,5 Demo.Hello');
        return;
      }

      var editorType = null;
      var nameLower = targetComponent.toLowerCase();
      if (nameLower.indexOf('.dtl.') !== -1) editorType = 'dtl';
      else if (nameLower.indexOf('.rule.') !== -1 || nameLower.endsWith('routingrule')) editorType = 'rule';
      else if (nameLower.indexOf('.bpl.') !== -1) editorType = 'bpl';
      else if (nameLower.endsWith('.production')) editorType = 'production';

      addMessage('system', 'Testing ' + strategies.length + ' strategies for: ' + targetComponent + ' (editor: ' + (editorType || 'auto') + ')');

      var strategyIndex = 0;

      function tryNext() {
        if (strategyIndex >= strategies.length) {
          addMessage('system', 'All strategies exhausted. Component not found: ' + targetComponent);
          saveState();
          return;
        }
        var strat = strategies[strategyIndex];
        strategyIndex++;
        addMessage('system', 'Strategy ' + strat + ': ' + strategyDesc(strat) + '...');

        runStrategy(strat, targetComponent, editorType, function(found) {
          if (found) {
            addMessage('system', 'SUCCESS with strategy ' + strat + ': ' + strategyDesc(strat));
            if (shouldExpandOnGoto(targetComponent)) {
              setTimeout(function() { clickExpandIcon(); }, 100);
            }
            saveState();
          } else {
            addMessage('system', 'Strategy ' + strat + ' failed — component not in DOM');
            tryNext();
          }
        });
      }

      tryNext();
    }

    function strategyDesc(n) {
      switch(n) {
        case 1: return 'Direct DOM click (no refresh)';
        case 2: return 'Toggle sidebar panel (collapse/expand)';
        case 3: return 'Namespace bounce v2 (querySelector-based)';
        case 4: return 'PopState event (trigger Angular router)';
        case 5: return 'Open panel menu click (close/reopen editor)';
        case 6: return 'Full page reload with overlay';
        default: return 'Unknown';
      }
    }

    function runStrategy(stratNum, target, editorType, callback) {
      var panelMap = { 'production': 1, 'rule': 2, 'dtl': 3, 'bpl': 4 };
      var panelIndex = panelMap[editorType] || 3;

      switch(stratNum) {
        case 1:
          // Strategy 1: Direct DOM click — no refresh, just look in current DOM
          var found = findAndClickComponent(target);
          callback(found);
          break;

        case 2:
          // Strategy 2: Toggle sidebar panel — collapse then re-expand
          (function() {
            var iconXpath = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[1]/div[2]/mat-icon/svg';
            // Click to collapse
            xpathClick(iconXpath);
            setTimeout(function() {
              // Click to expand
              xpathClick(iconXpath);
              setTimeout(function() {
                // Now try to click "Open Full" to re-open the full editor
                var dropdownBase = '/html/body/app-root/div[2]/app-dashboard/div[1]/div[' + panelIndex + ']/div[2]';
                var dropdownEl = null;
                try {
                  var r = document.evaluate(dropdownBase, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
                  dropdownEl = r.singleNodeValue;
                } catch(e) {}
                if (dropdownEl) {
                  var items = dropdownEl.children;
                  for (var di = 0; di < items.length; di++) {
                    if (items[di].textContent.trim().toLowerCase() === 'open full') {
                      items[di].click();
                      break;
                    }
                  }
                }
                // Wait for Angular to re-render list
                setTimeout(function() {
                  var found = findAndClickComponent(target);
                  callback(found);
                }, 1500);
              }, 500);
            }, 500);
          })();
          break;

        case 3:
          // Strategy 3: Namespace bounce v2 (querySelector-based)
          namespaceBounce(function(bounced) {
            if (!bounced) { callback(false); return; }
            var attempts = 0;
            var poll = setInterval(function() {
              attempts++;
              if (attempts === 1) executeGoto(target, editorType);
              var found = findAndClickComponent(target);
              if (found || attempts >= 20) {
                clearInterval(poll);
                callback(found);
              }
            }, 250);
          });
          break;

        case 4:
          // Strategy 4: PopState event — dispatch popstate to trigger Angular router
          (function() {
            // Add a dummy state then go back
            var url = new URL(window.location.href);
            url.searchParams.set('_refresh', Date.now());
            history.pushState({ refresh: true }, '', url.toString());
            window.dispatchEvent(new PopStateEvent('popstate', { state: { refresh: true } }));

            setTimeout(function() {
              // Restore original URL
              history.back();
              setTimeout(function() {
                executeGoto(target, editorType);
                setTimeout(function() {
                  var found = findAndClickComponent(target);
                  callback(found);
                }, 1500);
              }, 1500);
            }, 1500);
          })();
          break;

        case 5:
          // Strategy 5: Open panel menu — click sidebar icon to open the menu,
          // then click a different editor tab and come back (forces re-fetch)
          (function() {
            // Click to a different editor panel first
            var otherPanelIndex = (panelIndex === 3) ? 2 : 3; // switch between DTL(3) and Rule(2)
