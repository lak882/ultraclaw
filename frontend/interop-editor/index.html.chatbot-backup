    function addReasoningStep(step) {
      ensureStepsContainer();
      currentSteps.push(step);

      // Add connector line if more than 1 step
      if (currentSteps.length === 2 && currentStepsListEl) {
        var existing = currentStepsListEl.querySelector('.reasoning-connector');
