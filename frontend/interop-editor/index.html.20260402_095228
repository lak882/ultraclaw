/* Drag handle for resizing */
.chatbot-resize-handle{
  position:absolute;left:0;top:var(--fr-header-border-top-toolbar, 4px);bottom:0;width:6px;
  cursor:ew-resize;z-index:2;
  background:transparent;
  transition:background 0.15s ease;
}
.chatbot-resize-handle::after{
  content:'';position:absolute;left:2px;top:50%;
  transform:translateY(-50%);width:2px;height:32px;
  border-radius:1px;
  background:transparent;
  transition:background 0.15s ease, height 0.15s ease;
}
.chatbot-resize-handle:hover::after{
  background:var(--fr-styles-color-middle-grey, rgba(0,0,0,.3));height:48px;
}
body.chatbot-dragging .chatbot-resize-handle::after{
  background:var(--fr-styles-color-dark-grey, rgba(0,0,0,.4));height:48px;
}

/* Drag overlay — captures all mouse events during resize, prevents jank */
.drag-overlay{
  display:none;
  position:fixed;inset:0;
  z-index:9999;
  cursor:ew-resize;
}
body.chatbot-dragging .drag-overlay{display:block}
body.chatbot-dragging app-root{pointer-events:none}

/* Toolbar - match production config header:
   white bg, 4px primary border-top, 40px content height, 1px border-bottom (matches .toolbar in Angular app),
   near-black text, xs font-size, .05rem letter-spacing */
.chatbot-toolbar{
  background:white;
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  padding:0 16px;
  display:flex;justify-content:space-between;align-items:center;
  height:39px;
  min-height:39px;
  border-top:var(--fr-header-border-top-toolbar, 4px) solid var(--fr-styles-color-primary);
  border-bottom:2px solid rgba(0,0,0,.1215686275);
  box-shadow:none;
  box-sizing:content-box;
  position:relative;
  z-index:1;
  margin:0;
}
.chatbot-toolbar-title{
  display:flex;align-items:center;gap:8px;
  font-family:var(--mat-toolbar-title-text-font, 'Noto Sans','Noto Sans Arabic',Arial,sans-serif);
  font-size:var(--fr-header-font-size-top-bar-xs, var(--fr-styles-font-size-xs, .8125rem));
  font-weight:600;
  line-height:var(--mat-toolbar-title-text-line-height, 1.25rem);
  letter-spacing:.05rem;
}

/* Close button - matches toolbarIconLink: 29x29px, very-dark-grey icon color */
.chatbot-close{
  background:none;border:none;
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  font-size:16px;cursor:pointer;
  padding:0;line-height:1;
  border-radius:50%;
  transition:background 0.2s ease;
  width:29px;height:29px;
  display:flex;align-items:center;justify-content:center;
}
.chatbot-close:hover{background:rgba(0,0,0,.08)}
.chatbot-close:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:-2px;border-radius:50%}

/* Status bar */
.chatbot-status{
  background:white;
  padding:6px 16px;
  font-size:var(--fr-styles-font-size-xs);
  color:rgba(0,0,0,.6);
  border-bottom:1px solid rgba(0,0,0,.12);
  display:flex;align-items:center;gap:8px;
}
.chatbot-status-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--fr-styles-color-secondary);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* Message area - matches mat-sidenav-content background */
.chatbot-content{
  flex:1;padding:12px;overflow-y:auto;
  background:white;
  display:flex;flex-direction:column;gap:12px;
}
/* Scrollbar - matches the app global scrollbar */
.chatbot-content::-webkit-scrollbar{display:block;width:10px;position:absolute}
.chatbot-content::-webkit-scrollbar-track{background:var(--fr-styles-color-very-light-grey)}
.chatbot-content::-webkit-scrollbar-thumb{background:var(--fr-styles-color-light-grey);visibility:visible}

/* Messages — each message is a flex child of the column-flex .chatbot-content */
.chatbot-message{
  background:hsl(0, 0%, 97%);
  border:1px solid hsl(0, 0%, 90%);
  padding:8px 14px;
  border-radius:12px 12px 12px 2px;
  box-shadow:0 1px 2px #0001;
  font-size:var(--chatbot-font-size);
  line-height:1.5;
  color:rgba(0,0,0,.87);
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  word-break:break-word;
  max-width:90%;
  width:fit-content;
  align-self:flex-start;
}
/* Code blocks and tables inside bubbles */
.chatbot-message .chatbot-codeblock,
.chatbot-message .msg-content .chatbot-codeblock{
  max-width:100%;
  box-sizing:border-box;
  overflow-x:auto;
}
.chatbot-message .chatbot-table,
.chatbot-message .msg-content .chatbot-table{
  max-width:100%;
}
/* User messages — right-aligned, grey background (not blue) */
.chatbot-message-user{
  background:hsl(0, 0%, 92%);
  color:var(--fr-styles-color-near-black, #2b2b2b);
  border:none;
  border-radius:12px 12px 2px 12px;
  align-self:flex-end;
  max-width:85%;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
/* System messages — centered, subtle, no bubble */
.chatbot-message-system{
  background:transparent;
  color:rgba(0,0,0,.54);
  font-size:var(--fr-styles-font-size-xs);
  padding:4px 8px;
  box-shadow:none;
  border:none;
  border-radius:0;
  max-width:100%;
  width:auto;
  align-self:center;
  text-align:center;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
/* Tool-use messages — monospace, indented, gear icon feel */
.chatbot-message-tool{
  background:transparent;
  color:var(--fr-styles-color-dark-grey, hsl(0,0%,57%));
  font-size:var(--fr-styles-font-size-3xs, .6875rem);
  font-family:'Noto Sans Mono',Consolas,monospace;
  padding:2px 8px 2px 20px;
  box-shadow:none;
  border:none;
  border-left:2px solid var(--fr-styles-color-middle-grey, hsl(0,0%,80%));
  border-radius:0;
  max-width:100%;
  width:auto;
  align-self:flex-start;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
/* Error messages */
.chatbot-message-error{
  background:var(--fr-styles-color-alert-error-fill, #ffebee);
  color:var(--fr-styles-color-alert-error-border, #c62828);
  border-left:3px solid var(--fr-styles-color-alert-error-border, #c62828);
  border-radius:4px;
  border-top:none;
  border-right:none;
  border-bottom:none;
}

/* Input area */
.chatbot-input-container{
  position:relative;
  padding:8px 12px;
  border-top:1px solid rgba(0,0,0,.12);
  background:white;
}
.chatbot-typeahead{
  display:none;
  position:absolute;
  bottom:100%;
  left:0;right:0;
  background:white;
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-bottom:none;
  border-radius:4px 4px 0 0;
  max-height:200px;
  overflow-y:auto;
  z-index:10;
  box-shadow:0 -2px 8px rgba(0,0,0,.1);
}
.chatbot-typeahead-item{
  padding:6px 12px;
  cursor:pointer;
  display:flex;
  gap:8px;
  align-items:baseline;
  font-size:var(--chatbot-font-size);
  border-bottom:1px solid var(--fr-styles-color-very-light-grey, #f2f2f2);
}
.chatbot-typeahead-item:hover,
.chatbot-typeahead-item.active{
  background:var(--fr-styles-color-very-light-grey, #f5f5f5);
}
.chatbot-typeahead-cmd{
  font-weight:600;
  color:var(--fr-styles-color-primary);
  white-space:nowrap;
  font-family:'Noto Sans Mono',Consolas,monospace;
}
.chatbot-typeahead-desc{
  color:var(--fr-styles-color-dark-grey);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
/* Input field - matches mdc-outlined-text-field */
.chatbot-input{
  width:100%;
  padding:8px 12px;
  border:1px solid var(--mdc-outlined-text-field-outline-color, rgba(0,0,0,.38));
  border-radius:4px;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  font-size:var(--chatbot-font-size);
  color:rgba(0,0,0,.87);
  transition:border-color 0.2s ease;
  outline:none;
  height:36px;
  min-height:36px;
  max-height:40vh;
  resize:none;
  overflow-y:auto;
  line-height:18px;
  box-sizing:border-box;
}
.chatbot-input::placeholder{color:var(--mdc-outlined-text-field-input-text-placeholder-color, rgba(0,0,0,.6))}
.chatbot-input:hover{border-color:var(--mdc-outlined-text-field-hover-outline-color, rgba(0,0,0,.87))}
.chatbot-input:focus{
  border-color:var(--fr-styles-color-state-focused);
  border-width:2px;
  padding:7px 11px;
}

/* Actions row below the textarea */
.chatbot-input-actions{
  display:flex;align-items:center;gap:6px;
  margin-top:6px;
}

/* Send button - round arrow button on the right */
.chatbot-send-btn{
  background:var(--fr-styles-color-near-black, #2b2b2b);
  color:white;
  border:none;
  border-radius:50%;
  width:30px;height:30px;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;
  transition:background 0.15s ease;
  flex-shrink:0;
  padding:0;
}
.chatbot-send-btn:hover:not(:disabled){
  background:var(--fr-styles-color-primary);
}
.chatbot-send-btn:disabled{
  background:rgba(0,0,0,.12);
  color:rgba(0,0,0,.38);
  cursor:not-allowed;
}
.chatbot-send-btn:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px}
.chatbot-stop-btn{background:var(--fr-styles-color-middle-dark-grey, #888) !important;margin-left:auto;margin-right:2px}
.chatbot-stop-btn:hover{background:var(--fr-styles-color-near-black, #555) !important}

/* Custom model selector dropdown */
.chatbot-model-selector{position:relative}
.chatbot-model-btn{
  background:none;border:1px solid var(--fr-styles-color-light-grey, hsl(0,0%,88%));
  border-radius:12px;
  padding:2px 8px;
  font-size:var(--fr-styles-font-size-3xs, 11px);
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  cursor:pointer;font-family:inherit;
  display:flex;align-items:center;gap:4px;
  transition:background 0.15s ease, border-color 0.15s ease;
  white-space:nowrap;
}
.chatbot-model-btn:hover{background:var(--fr-styles-color-very-light-grey, #f2f2f2);border-color:rgba(0,0,0,.24)}
.chatbot-model-btn svg{flex-shrink:0}
.chatbot-model-dropdown{
  display:none;
  position:absolute;bottom:100%;left:0;
  margin-bottom:4px;
  background:white;
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:8px;
  box-shadow:0 4px 12px rgba(0,0,0,.15);
  min-width:220px;
  z-index:20;
  overflow:hidden;
}
.chatbot-model-dropdown.open{display:block}
.chatbot-model-option{
  padding:8px 12px;cursor:pointer;
  transition:background 0.1s ease;
}
.chatbot-model-option:hover{background:var(--fr-styles-color-very-light-grey, #f5f5f5)}
.chatbot-model-option.selected{background:var(--fr-styles-color-very-light-grey, #f5f5f5)}
.chatbot-model-option .model-name{
  display:block;font-size:var(--fr-styles-font-size-xs);
  font-weight:600;color:var(--fr-styles-color-near-black);
}
.chatbot-model-option .model-desc{
  display:block;font-size:var(--fr-styles-font-size-3xs, 11px);
  color:var(--fr-styles-color-dark-grey);margin-top:1px;
}

/* Toggle button - subtle pill matching toolbar icon style */
#chatbot-toggle{
  position:fixed;bottom:12px;right:22px;
  height:30px;
  padding:0 12px;
  border-radius:4px;
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  border:1px solid var(--mat-divider-color, rgba(0,0,0,.12));
  cursor:pointer;
  z-index:10001;
  box-shadow:0 2px 4px -1px #0003,0 4px 5px #00000024,0 1px 10px #0000001f;
  font-size:var(--fr-styles-font-size-xs);
  font-weight:600;
  letter-spacing:.05rem;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  display:none;align-items:center;justify-content:center;gap:6px;
  transition:background 0.2s ease,box-shadow 0.2s ease,border-color 0.2s ease;
}
#chatbot-toggle:hover{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border-color:rgba(0,0,0,.24);
  box-shadow:0 3px 5px -1px #0003,0 6px 10px #00000024,0 1px 18px #0000001f;
}
#chatbot-toggle:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px}
body.chatbot-closed #chatbot-toggle{display:flex}

/* Upload (paperclip) button - circular */
.chatbot-upload-btn{
  display:flex;align-items:center;justify-content:center;
  width:30px;height:30px;border-radius:50%;
  border:1px solid var(--mdc-outlined-text-field-outline-color, rgba(0,0,0,.38));
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  cursor:pointer;
  transition:background 0.15s ease, border-color 0.15s ease;
  flex-shrink:0;
}
.chatbot-upload-btn:hover{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border-color:var(--mdc-outlined-text-field-hover-outline-color, rgba(0,0,0,.87));
}

/* File attachment chips */
.chatbot-attachment-chip{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--fr-styles-color-near-white, #fafafa);
  border:1px solid var(--fr-styles-color-light-grey, hsl(0,0%,88%));
  border-radius:16px;
  padding:4px 10px 4px 12px;
  font-size:var(--fr-styles-font-size-xs);
  color:var(--fr-styles-color-near-black);
  max-width:200px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.chatbot-attachment-remove{
  cursor:pointer;
  color:var(--fr-styles-color-dark-grey);
  font-size:14px;
  border:none;
  background:none;
  padding:0;
  width:16px;height:16px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.15s ease, color 0.15s ease;
  flex-shrink:0;
}
.chatbot-attachment-remove:hover{
  color:var(--fr-styles-color-warning, red);
  background:rgba(0,0,0,.06);
}
.chatbot-attachments{
  display:flex;flex-wrap:wrap;gap:6px;
  padding:6px 0 0;
  margin-bottom:8px;
}

/* Markdown rendering styles */
.chatbot-codeblock{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:4px;
  padding:8px 12px;
  margin:6px 0;
  overflow-x:auto;
  font-family:'Noto Sans Mono',Consolas,monospace;
  font-size:var(--chatbot-font-size-code);
  line-height:1.5;
  white-space:pre;
}
.chatbot-inline-code{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:3px;
  padding:1px 4px;
  font-family:'Noto Sans Mono',Consolas,monospace;
  font-size:0.9em;
}
.chatbot-message strong{font-weight:700}
.chatbot-message em{font-style:italic}
.chatbot-h{margin:8px 0 4px;font-weight:700;line-height:1.3}
.chatbot-message h2.chatbot-h{font-size:1.1em}
.chatbot-message h3.chatbot-h{font-size:1em}
.chatbot-message h4.chatbot-h{font-size:0.95em}
.chatbot-message h5.chatbot-h{font-size:0.9em}
.chatbot-list{margin:4px 0;padding-left:20px;list-style:disc}
.chatbot-list li{margin:2px 0}
.chatbot-list-ordered{margin:4px 0;padding-left:20px;list-style:decimal}
.chatbot-list-ordered li{margin:2px 0}
.chatbot-link{color:var(--fr-styles-color-primary);text-decoration:underline}
.chatbot-link:hover{text-decoration:none}
.chatbot-table{
  width:100%;
  border-collapse:collapse;
  margin:6px 0;
  font-size:var(--fr-styles-font-size-xs);
}
.chatbot-table th,.chatbot-table td{
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  padding:4px 8px;
  text-align:left;
}
.chatbot-table th{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  font-weight:600;
}
.chatbot-table tr:nth-child(even){background:var(--fr-styles-color-near-white, #fafafa)}
.chatbot-hr{
  border:none;
  border-top:1px solid var(--fr-styles-color-light-grey);
  margin:8px 0;
}
/* Thinking blocks */
.thinking-block{
  background:rgba(0,0,0,0.03);
  border-left:2px solid var(--fr-styles-color-middle-grey, hsl(0,0%,80%));
  padding:4px 8px;
  margin:4px 0;
  font-style:italic;
  font-size:var(--chatbot-font-size-code, var(--fr-styles-font-size-3xs, .6875rem));
  color:var(--fr-styles-color-dark-grey, hsl(0,0%,57%));
  max-height:200px;
  overflow-y:auto;
  white-space:pre-wrap;
}
.msg-usage{
  font-size:9px;
  color:var(--fr-styles-color-middle-dark-grey, #aaa);
  margin-top:2px;
  text-align:right;
}
.msg-timestamp{
  font-size:9px;
  color:var(--fr-styles-color-middle-dark-grey, #aaa);
  margin-top:2px;
  text-align:right;
}
/* Right-align timestamp for user messages */
.chatbot-msg-wrap--user .msg-timestamp{text-align:right}

/* Wrapper for message + external timestamp/usage */
.chatbot-msg-wrap{
  display:flex;flex-direction:column;
  align-items:flex-start;
  gap:0;
}
.chatbot-msg-wrap--user{align-items:flex-end}
.thinking-hidden .thinking-block{display:none}
.thinking-toggle-active{
  background:rgba(0,0,0,0.08) !important;
  color:var(--fr-styles-color-primary) !important;
}
/* Reload overlay — covers the flash during page reload */
.reload-overlay{
  position:fixed;inset:0;
  background:var(--mat-sidenav-content-background-color, #fafafa);
  z-index:99999;
  transition:opacity 0.3s ease;
}
.reload-overlay.fade-out{
  opacity:0;
  pointer-events:none;
}
