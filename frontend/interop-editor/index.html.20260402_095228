/* ===== Angular CDK Overlay Containment ===== */
/* Push Angular Material overlays/popups/dialogs aside like app-root so they
   don't render behind the chatbot sidebar. The cdk-overlay-container is a
   direct child of <body> with position:fixed; left:0; right:0, so overriding
   right constrains it to the area left of the sidebar. */
.cdk-overlay-container {
  right: var(--chatbot-width) !important;
  transition: right 0.25s cubic-bezier(0.0, 0.0, 0.2, 1);
}
body.chatbot-closed .cdk-overlay-container {
  right: 0 !important;
}
body.chatbot-fullscreen .cdk-overlay-container {
  display: none !important;
}
body.chatbot-dragging .cdk-overlay-container {
  transition: none !important;
}
/* Snackbars / toasts also need constraining */
.mat-mdc-snack-bar-container {
  max-width: calc(100vw - var(--chatbot-width)) !important;
}
body.chatbot-closed .mat-mdc-snack-bar-container {
  max-width: 100vw !important;
}

/* ===== Chatbot Sidebar ===== */
#chatbot-sidebar{
  position:fixed;right:0;top:0;height:100vh;width:var(--chatbot-width, 400px);
  background:var(--fr-styles-color-primary);/* top edge matches blue border-top; toolbar covers the rest */
  border-left:none;
  z-index:10000;
  display:flex;flex-direction:column;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  transition:transform 0.25s cubic-bezier(0.0, 0.0, 0.2, 1);
  will-change:transform;
  transform:translateZ(0);
  contain:layout style;
  /* Match mat-elevation-z6 used by mat-sidenav */
  box-shadow:none;
  /* Configurable font size — default xs, updated from config on startup */
  --chatbot-font-size: var(--fr-styles-font-size-xs);
  --chatbot-font-size-code: var(--fr-styles-font-size-3xs);
}
body.chatbot-closed #chatbot-sidebar{transform:translateX(100%)}
#chatbot-sidebar::before{
  content:'';
  position:absolute;
  left:0;
  top:var(--fr-header-border-top-toolbar, 4px);
  bottom:0;
  width:1px;
  background:var(--fr-styles-color-light-grey, hsl(0,0%,88%));
  z-index:3;
  pointer-events:none;
