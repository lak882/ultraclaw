              <span class="model-name">Claude Haiku 4.5</span>
              <span class="model-desc">Fastest responses for simple tasks</span>
            </div>
          </div>
        </div>
        <button class="chatbot-send-btn chatbot-stop-btn" id="chatbot-stop" onclick="stopGeneration()" title="Stop"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/></svg></button>
        <button class="chatbot-send-btn" id="chatbot-send" onclick="sendMessage()" title="Send"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg></button>
      </div>
    </div>
  </div>

  <button id="chatbot-toggle" onclick="toggleChatbot()">Open Connect</button>

  <script>
    var sessionId = null;
    var apiBase = 'http://' + (window.location.hostname || 'localhost') + ':8765';
    var attachedFiles = [];
    var messageQueue = [];
    var sessionReady = false;
    var isReloading = false;

    // Font size configuration — maps config value to one-step-smaller code-block size
    var fontSizeCodeMap = {'3xs':'3xs','2xs':'3xs','xs':'3xs','sm':'2xs','base':'xs'};

    function applyFontSizeConfig(size) {
      var valid = ['3xs','2xs','xs','sm','base'];
      if (valid.indexOf(size) === -1) size = 'xs';
      var sidebar = document.getElementById('chatbot-sidebar');
      sidebar.style.setProperty('--chatbot-font-size', 'var(--fr-styles-font-size-' + size + ')');
      var codeSize = fontSizeCodeMap[size] || '3xs';
      sidebar.style.setProperty('--chatbot-font-size-code', 'var(--fr-styles-font-size-' + codeSize + ')');
    }

    var modelLabels = { opus: 'Opus 4.6', sonnet: 'Sonnet 4.5', haiku: 'Haiku 4.5' };
    var currentModel = 'sonnet';

    function getSelectedModel() { return currentModel; }

    function setSelectedModel(model) {
      var valid = ['haiku', 'sonnet', 'opus'];
      if (valid.indexOf(model) === -1) model = 'sonnet';
      currentModel = model;
      document.getElementById('chatbot-model-label').textContent = modelLabels[model] || model;
      // Update selected class in dropdown
      var opts = document.querySelectorAll('#chatbot-model-dropdown .chatbot-model-option');
      opts.forEach(function(o) { o.classList.toggle('selected', o.dataset.value === model); });
      sessionStorage.setItem('chatbot-model', model);
    }

    function applyModelConfig(defaultModel) {
      var saved = sessionStorage.getItem('chatbot-model');
      setSelectedModel(saved || defaultModel || 'sonnet');
    }

    // Custom model dropdown logic
    (function() {
      var btn = document.getElementById('chatbot-model-btn');
      var dropdown = document.getElementById('chatbot-model-dropdown');

      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        dropdown.classList.toggle('open');
      });

      dropdown.addEventListener('click', function(e) {
        var opt = e.target.closest('.chatbot-model-option');
        if (opt && opt.dataset.value) {
          setSelectedModel(opt.dataset.value);
          dropdown.classList.remove('open');
        }
      });

      document.addEventListener('click', function() {
        dropdown.classList.remove('open');
      });
    })();

    function fetchConfig() {
      return fetch(apiBase + '/api/config')
        .then(function(resp) {
          if (!resp.ok) throw new Error('HTTP ' + resp.status);
          return resp.json();
        })
        .then(function(config) {
          var size = config.display && config.display.fontSize || 'xs';
          applyFontSizeConfig(size);
          var defaultModel = config.display && config.display.defaultModel || 'sonnet';
          applyModelConfig(defaultModel);
        })
        .catch(function(e) {
          console.log('[chatbot] Config fetch failed, using defaults:', e.message);
          applyModelConfig('sonnet');
        });
    }

    var currentAbortController = null;

    var currentStreamEl = null;
    var currentStreamWrap = null;
    var currentStreamText = '';
    var currentThinkingEl = null;
    var currentThinkingText = '';
    var renderTimeout = null;
    var showThinking = sessionStorage.getItem('chatbot-show-thinking') !== 'false';

    // Timer, usage tracking, and response timeout
    var queryStartTime = null;
    var timerInterval = null;
    var usageShown = false;
    var responseTimeout = null;

    function startResponseTimeout() {
      clearResponseTimeout();
    }

    function resetResponseTimeout() {
      if (responseTimeout) {
        clearTimeout(responseTimeout);
        responseTimeout = null;
      }
    }

    function clearResponseTimeout() {
      if (responseTimeout) {
        clearTimeout(responseTimeout);
        responseTimeout = null;
      }
    }

    var lastStatusBase = '';

    function startTimer() {
      queryStartTime = Date.now();
      usageShown = false;
      lastStatusBase = 'Thinking...';
      timerInterval = setInterval(function() {
        var elapsed = ((Date.now() - queryStartTime) / 1000).toFixed(1);
        document.getElementById('chatbot-status-text').textContent = lastStatusBase + ' (' + elapsed + 's)';
      }, 100);
    }

    function stopTimer() {
      if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
      }
    }

    function showStopButton() {
      document.getElementById('chatbot-stop').style.display = '';
    }

    function hideStopButton() {
      // Stop button always visible — no-op
    }

    function stopGeneration() {
      if (currentAbortController) {
        currentAbortController.abort();
        currentAbortController = null;
      }
      stopTimer();
      clearResponseTimeout();
      updateStatus('Cancelled');
      finalizeCurrentBubble();
      hideStopButton();
    }

    function toggleThinking() {
      showThinking = !showThinking;
      sessionStorage.setItem('chatbot-show-thinking', showThinking ? 'true' : 'false');
      updateThinkingToggle();
    }

    function updateThinkingToggle() {
      var btn = document.getElementById('chatbot-thinking-btn');
      var content = document.getElementById('chatbot-content');
      if (!btn) return;
      if (showThinking) {
        btn.classList.add('thinking-toggle-active');
        btn.title = 'Hide thinking';
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>';
        if (content) content.classList.remove('thinking-hidden');
      } else {
        btn.classList.remove('thinking-toggle-active');
        btn.title = 'Show thinking';
        btn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 11-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>';
        if (content) content.classList.add('thinking-hidden');
      }
    }

    document.getElementById('chatbot-file-input').addEventListener('change', function(e) {
      var files = Array.from(e.target.files);
      files.forEach(function(file) {
        attachedFiles.push(file);
      });
      updateAttachmentUI();
      e.target.value = '';
    });

    function updateAttachmentUI() {
      var container = document.getElementById('chatbot-attachments');
      if (attachedFiles.length === 0) {
        container.style.display = 'none';
        container.innerHTML = '';
        return;
      }
      container.style.display = 'flex';
      container.innerHTML = attachedFiles.map(function(f, i) {
        return '<span class="chatbot-attachment-chip">' +
          f.name +
          ' <button class="chatbot-attachment-remove" onclick="removeAttachment(' + i + ')">&times;</button>' +
          '</span>';
      }).join('');
    }

    function removeAttachment(index) {
      attachedFiles.splice(index, 1);
      updateAttachmentUI();
    }

    var FILE_MAX_BYTES = 100 * 1024; // 100 KB per file

    function readFileWithTimeout(blob, timeout) {
      return Promise.race([
        blob.text(),
        new Promise(function(_, reject) {
          setTimeout(function() { reject(new Error('File read timed out after ' + (timeout / 1000) + 's')); }, timeout);
        })
      ]);
    }

    async function readAttachedFiles() {
      var FILE_READ_TIMEOUT = 5000; // 5 seconds per file
      var parts = [];
      for (var i = 0; i < attachedFiles.length; i++) {
        var file = attachedFiles[i];
        var truncated = false;
        var content;
        try {
          // Read only the first FILE_MAX_BYTES to avoid huge payloads
          var slice = file.size > FILE_MAX_BYTES ? file.slice(0, FILE_MAX_BYTES) : file;
          content = await readFileWithTimeout(slice, FILE_READ_TIMEOUT);
          if (file.size > FILE_MAX_BYTES) {
            truncated = true;
          }
          // Detect binary content — if more than 5 % of chars are control chars it is
          // likely not a text file and will break JSON serialization.
          var controlCount = 0;
          for (var c = 0; c < Math.min(content.length, 4096); c++) {
            var code = content.charCodeAt(c);
            if (code < 32 && code !== 9 && code !== 10 && code !== 13) controlCount++;
          }
          if (controlCount / Math.min(content.length, 4096) > 0.05) {
            parts.push('--- File: ' + file.name + ' (binary, ' + file.size + ' bytes) ---\n[Binary file — content not included. Describe what you need from it.]');
            continue;
          }
          // Strip any stray null bytes that would break JSON
          content = content.replace(/\0/g, '');
        } catch (err) {
          parts.push('--- File: ' + file.name + ' ---\n[Could not read file: ' + err.message + ']');
          continue;
        }
        var header = '--- File: ' + file.name + ' (' + file.size + ' bytes' + (truncated ? ', truncated to first 100KB' : '') + ') ---';
        parts.push(header + '\n' + content);
      }
      return parts.join('\n\n');
    }

    function toggleChatbot() {
      document.body.classList.toggle('chatbot-closed');
      // Exit fullscreen when closing
      if (document.body.classList.contains('chatbot-closed')) {
        document.body.classList.remove('chatbot-fullscreen');
        updateFullscreenIcon();
      }
    }

    function toggleFullscreen() {
      var wasFullscreen = document.body.classList.contains('chatbot-fullscreen');

      if (wasFullscreen) {
        // Exit fullscreen — reload the page so Angular app-root reinitializes cleanly
        isReloading = true;
        saveState();
        sessionStorage.setItem('chatbot-programmatic-reload', '1');
        // Show overlay to prevent flash
        var overlay = document.getElementById('reload-overlay');
        if (overlay) {
          overlay.style.display = 'block';
          overlay.classList.remove('fade-out');
        }
        window.location.reload();
        return; // Don't remove chatbot-fullscreen class - let reload handle it
      }

      // Entering fullscreen — works as before
      document.body.classList.add('chatbot-fullscreen');
      updateFullscreenIcon();
    }

    function updateFullscreenIcon() {
      var btn = document.getElementById('chatbot-fullscreen-btn');
      if (!btn) return;
      if (document.body.classList.contains('chatbot-fullscreen')) {
        btn.innerHTML = '&#x25F1;'; // restore icon
        btn.title = 'Exit Fullscreen';
      } else {
        btn.innerHTML = '&#x26F6;'; // expand icon
        btn.title = 'Fullscreen';
      }
    }

    // --- Resize handle drag logic (GPU-accelerated with transform) ---
    (function() {
      var handle = document.getElementById('chatbot-resize-handle');
      var sidebar = document.getElementById('chatbot-sidebar');
      var isDragging = false;
      var rafId = null;
      var pendingWidth = null;
      var startX, startWidth;
      var MIN_WIDTH = 300;

      handle.addEventListener('mousedown', function(e) {
        e.preventDefault();
        isDragging = true;
        startX = e.clientX;
        startWidth = document.getElementById('chatbot-sidebar').offsetWidth || 400;
        document.body.classList.add('chatbot-dragging');
      });

      document.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        var delta = startX - e.clientX;
        var newWidth = startWidth + delta;
        if (newWidth < MIN_WIDTH) newWidth = MIN_WIDTH;
        if (newWidth > window.innerWidth * 0.9) newWidth = window.innerWidth * 0.9;
        pendingWidth = newWidth;
        if (!rafId) {
          rafId = requestAnimationFrame(function() {
            if (pendingWidth !== null) {
              document.documentElement.style.setProperty('--chatbot-width', pendingWidth + 'px');
              pendingWidth = null;
            }
            rafId = null;
          });
        }
      });

      document.addEventListener('mouseup', function() {
        if (!isDragging) return;
        isDragging = false;
        document.body.classList.remove('chatbot-dragging');
        if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        // Apply final pending width so sidebar doesn't snap back
        if (pendingWidth !== null) {
          document.documentElement.style.setProperty('--chatbot-width', pendingWidth + 'px');
          pendingWidth = null;
        }
      });
    })();

    // Auto-connect on load (restore previous session if available)
    window.addEventListener('load', function() {
      // Fetch config (font size, etc.) before rendering — non-blocking
      fetchConfig();
      // Initialize thinking toggle state
      updateThinkingToggle();

      setTimeout(function() {
        var isProgrammatic = sessionStorage.getItem('chatbot-programmatic-reload');
        sessionStorage.removeItem('chatbot-programmatic-reload'); // always clear it

        if (isProgrammatic && restoreState()) {
          // Restored from programmatic reload
        } else {
          // Manual reload or no saved state — clear old state and start fresh
          sessionStorage.removeItem('chatbot-state');
          initSession();
        }
        checkPendingClick();

        // Fade out the reload overlay after Angular has had time to render
        setTimeout(function() {
          var overlay = document.getElementById('reload-overlay');
          if (overlay && overlay.style.display !== 'none') {
            overlay.classList.add('fade-out');
            setTimeout(function() {
              overlay.style.display = 'none';
              overlay.classList.remove('fade-out');
            }, 300);
          }
        }, 400);
      }, 300);
    });

    function detectNamespace() {
      var path = window.location.pathname;
      var match = path.match(/\/healthshare\/([^\/]+)/i);
      if (match) return match[1].toUpperCase();
      // Also check $NAMESPACE query parameter
      var params = new URLSearchParams(window.location.search);
      var ns = params.get('$NAMESPACE') || params.get('NAMESPACE');
      return ns ? ns.toUpperCase() : null;
    }

    // --- Namespace change detection ---
    // Track the current namespace so we can detect switches
    var currentNamespace = detectNamespace();

    // Override history methods to catch Angular's client-side navigation
    (function() {
      var originalPushState = history.pushState;
      var originalReplaceState = history.replaceState;

      history.pushState = function() {
        originalPushState.apply(this, arguments);
        checkNamespaceChange();
      };

      history.replaceState = function() {
        originalReplaceState.apply(this, arguments);
        checkNamespaceChange();
      };

      // Also catch back/forward button navigation
      window.addEventListener('popstate', checkNamespaceChange);

      // Periodic fallback: some Angular navigations may not trigger
      // pushState/replaceState, so poll every 2 seconds
      setInterval(checkNamespaceChange, 2000);
    })();

    function checkNamespaceChange() {
      var newNamespace = detectNamespace();
      if (newNamespace && newNamespace !== currentNamespace) {
        currentNamespace = newNamespace;
        onNamespaceChanged(newNamespace);
      }
    }

    function onNamespaceChanged(namespace) {
      addMessage('system', 'Switched to namespace ' + namespace);
    }

    function sendCommandToBackend(command) {
      suppressAssistant = false;
      updateStatus('Thinking...');
      startTimer();
      startResponseTimeout();
      currentAbortController = new AbortController();
      showStopButton();

      fetch(apiBase + '/api/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ session_id: sessionId, text: command, model: getSelectedModel() }),
        signal: currentAbortController.signal,
      })
      .then(function(resp) {
        if (!resp.ok) {
          stopTimer();
          clearResponseTimeout();
          throw new Error('HTTP ' + resp.status);
        }
        return readSSE(resp);
      })
      .catch(function(e) {
        if (e.name === 'AbortError') return;
        if (isReloading) return;
        stopTimer();
        clearResponseTimeout();
        addMessage('error', 'Command failed: ' + e.message);
        updateStatus('Error');
      })
      .finally(function() {
        currentAbortController = null;
        hideStopButton();
      });
    }

    function updateStatus(text) {
      // Save base text so timer can append elapsed time to it
      lastStatusBase = text;
      if (timerInterval && queryStartTime) {
        var elapsed = ((Date.now() - queryStartTime) / 1000).toFixed(1);
        document.getElementById('chatbot-status-text').textContent = text + ' (' + elapsed + 's)';
      } else {
        document.getElementById('chatbot-status-text').textContent = text;
      }
    }

    var lastAssistantMsg = null;
    var suppressAssistant = false;

    function renderMarkdown(text) {
      // Escape HTML
      var html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Code blocks (must be first to protect content inside)
      var codeBlocks = [];
      html = html.replace(/```(\w*)\n([\s\S]*?)```/g, function(m, lang, code) {
        var idx = codeBlocks.length;
        codeBlocks.push('<pre class="chatbot-codeblock"><code>' + code.trimEnd() + '</code></pre>');
        return '\x00CODEBLOCK' + idx + '\x00';
      });

      // Inline code (protect from further processing)
      var inlineCodes = [];
      html = html.replace(/`([^`]+)`/g, function(m, code) {
        var idx = inlineCodes.length;
        inlineCodes.push('<code class="chatbot-inline-code">' + code + '</code>');
        return '\x00INLINE' + idx + '\x00';
      });

      // Tables
      html = html.replace(/^(\|.+\|)\n(\|[\s\-:|]+\|)\n((?:\|.+\|\n?)+)/gm, function(m, header, sep, body) {
        var headers = header.split('|').filter(function(c){return c.trim()});
        var rows = body.trim().split('\n');
        var table = '<table class="chatbot-table"><thead><tr>';
        headers.forEach(function(h) { table += '<th>' + h.trim() + '</th>'; });
        table += '</tr></thead><tbody>';
        rows.forEach(function(row) {
          var cells = row.split('|').filter(function(c){return c.trim()});
          table += '<tr>';
          cells.forEach(function(c) { table += '<td>' + c.trim() + '</td>'; });
          table += '</tr>';
        });
        table += '</tbody></table>';
        return table;
      });

      // Horizontal rules (standalone --- lines, not inside tables)
      html = html.replace(/^---+$/gm, '<hr class="chatbot-hr">');

      // Headers
      html = html.replace(/^#### (.+)$/gm, '<h5 class="chatbot-h">$1</h5>');
      html = html.replace(/^### (.+)$/gm, '<h4 class="chatbot-h">$1</h4>');
      html = html.replace(/^## (.+)$/gm, '<h3 class="chatbot-h">$1</h3>');
      html = html.replace(/^# (.+)$/gm, '<h2 class="chatbot-h">$1</h2>');

      // Bold (before italic)
      html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/__(.+?)__/g, '<strong>$1</strong>');

      // Italic
      html = html.replace(/\*(.+?)\*/g, '<em>$1</em>');
      html = html.replace(/_(.+?)_/g, '<em>$1</em>');

      // Links
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" class="chatbot-link">$1</a>');

      // Ordered lists (must come before unordered to distinguish)
      html = html.replace(/(?:^\d+\. .+\n?)+/gm, function(m) {
        var items = m.trim().split('\n').map(function(line) {
          return '<li>' + line.replace(/^\d+\. /, '') + '</li>';
        }).join('');
        return '<ol class="chatbot-list-ordered">' + items + '</ol>';
      });

      // Unordered lists
      html = html.replace(/(?:^[\-\*] .+\n?)+/gm, function(m) {
        var items = m.trim().split('\n').map(function(line) {
          return '<li>' + line.replace(/^[\-\*] /, '') + '</li>';
        }).join('');
        return '<ul class="chatbot-list">' + items + '</ul>';
      });

      // Line breaks (not inside block elements)
      html = html.replace(/\n/g, '<br>');

      // Clean up <br> around block elements
      html = html.replace(/<br><\/(pre|ul|ol|table|h[2-5]|li|hr)>/g, '</$1>');
      html = html.replace(/<(pre|ul|ol|table|h[2-5]|hr)([^>]*)><br>/g, '<$1$2>');
      html = html.replace(/<br><(pre|ul|ol|table|h[2-5]|hr)/g, '<$1');

      // Restore code blocks and inline code
      html = html.replace(/\x00CODEBLOCK(\d+)\x00/g, function(m, i) { return codeBlocks[parseInt(i)]; });
      html = html.replace(/\x00INLINE(\d+)\x00/g, function(m, i) { return inlineCodes[parseInt(i)]; });

      return html;
    }

    function saveState() {
      var state = {
        sessionId: sessionId,
        messages: []
      };
      var children = document.getElementById('chatbot-content').children;
      for (var i = 0; i < children.length; i++) {
        var el = children[i];
        // Handle wrapper divs — find the actual message inside
        var msgEl = el.classList.contains('chatbot-msg-wrap') ? el.querySelector('.chatbot-message') : el;
        if (!msgEl) continue;
        var type = 'assistant';
        if (msgEl.classList.contains('chatbot-message-user')) type = 'user';
        else if (msgEl.classList.contains('chatbot-message-system')) type = 'system';
        else if (msgEl.classList.contains('chatbot-message-error')) type = 'error';
        else if (msgEl.classList.contains('chatbot-message-tool')) type = 'tool';
        state.messages.push({ type: type, html: msgEl.innerHTML });
      }
      sessionStorage.setItem('chatbot-state', JSON.stringify(state));
    }

    function restoreState() {
      var saved = sessionStorage.getItem('chatbot-state');
      if (!saved) return false;
      try {
        var state = JSON.parse(saved);
        if (!state.sessionId) return false;

        sessionId = state.sessionId;
        var content = document.getElementById('chatbot-content');

        // Restore messages
        state.messages.forEach(function(m) {
          var msg = document.createElement('div');
          msg.className = 'chatbot-message';
          if (m.type === 'user') msg.className += ' chatbot-message-user';
          else if (m.type === 'system') msg.className += ' chatbot-message-system';
          else if (m.type === 'error') msg.className += ' chatbot-message-error';
          else if (m.type === 'tool') msg.className += ' chatbot-message-tool';
          msg.innerHTML = m.html;
          // Only wrap user and assistant messages
          if (m.type === 'user' || m.type === 'assistant') {
            var wrap = document.createElement('div');
            wrap.className = 'chatbot-msg-wrap' + (m.type === 'user' ? ' chatbot-msg-wrap--user' : '');
            wrap.appendChild(msg);
            content.appendChild(wrap);
          } else {
            content.appendChild(msg);
          }
        });

        content.scrollTop = content.scrollHeight;

        sessionReady = true;
        updateStatus('Connected');

        return true;
      } catch(e) {
        return false;
      }
    }

    function formatTimestamp() {
      var now = new Date();
      var h = now.getHours(); var m = now.getMinutes();
      var ampm = h >= 12 ? 'PM' : 'AM';
      h = h % 12 || 12;
      return h + ':' + (m < 10 ? '0' : '') + m + ' ' + ampm;
    }

    function createTimestamp() {
      var ts = document.createElement('div');
      ts.className = 'msg-timestamp';
      ts.textContent = formatTimestamp();
      return ts;
    }

    function wrapMessage(msgEl, isUser) {
      var wrap = document.createElement('div');
      wrap.className = 'chatbot-msg-wrap' + (isUser ? ' chatbot-msg-wrap--user' : '');
      wrap.appendChild(msgEl);
      wrap.appendChild(createTimestamp());
      return wrap;
    }

    function addMessage(type, text) {
      text = (text || '').trim();
      if (!text) return;
      var content = document.getElementById('chatbot-content');

      // For assistant messages, always create a new bubble
      if (type === 'assistant') {
        var assistantMsg = document.createElement('div');
        assistantMsg.className = 'chatbot-message';
        assistantMsg.innerHTML = '<div class="msg-content">' + renderMarkdown(text) + '</div>';
        content.appendChild(wrapMessage(assistantMsg, false));
        content.scrollTop = content.scrollHeight;
        saveState();
        return;
      }

      var msg = document.createElement('div');
      msg.className = 'chatbot-message';
      if (type === 'user') msg.className += ' chatbot-message-user';
      else if (type === 'system') msg.className += ' chatbot-message-system';
      else if (type === 'error') msg.className += ' chatbot-message-error';

      msg.textContent = text;
      if (type === 'user' || type === 'assistant') {
        content.appendChild(wrapMessage(msg, type === 'user'));
      } else {
        content.appendChild(msg);
      }
      content.scrollTop = content.scrollHeight;
      saveState();
    }

    /** Read an SSE stream from a fetch Response and dispatch events */
    async function readSSE(response) {
      var reader = response.body.getReader();
      var decoder = new TextDecoder();
      var buffer = '';

      while (true) {
        var result = await reader.read();
        if (result.done) break;
        buffer += decoder.decode(result.value, { stream: true });

        var lines = buffer.split('\n');
        buffer = lines.pop(); // keep incomplete line in buffer

        for (var i = 0; i < lines.length; i++) {
          var line = lines[i].trim();
          if (line.indexOf('data: ') !== 0) continue;
          try {
            var data = JSON.parse(line.substring(6));
            handleEvent(data);
          } catch (e) { /* skip malformed */ }
        }
      }
    }

    /** Finalize the current streaming bubble so the next text starts a fresh one */
    function finalizeCurrentBubble() {
      if (currentStreamEl && currentStreamText) {
        clearTimeout(renderTimeout);
        renderTimeout = null;
        var trimmed = currentStreamText.trim();
        var contentEl = currentStreamEl.querySelector('.msg-content');
        if (contentEl && trimmed) contentEl.innerHTML = renderMarkdown(trimmed);
        // Remove empty bubbles (remove the wrapper)
        if (!trimmed && currentStreamWrap && currentStreamWrap.parentNode) {
          currentStreamWrap.parentNode.removeChild(currentStreamWrap);
        }
      }
      currentStreamEl = null;
      currentStreamWrap = null;
      currentStreamText = '';
      currentThinkingEl = null;
      currentThinkingText = '';
    }

    function handleEvent(data) {
      var chatMessages = document.getElementById('chatbot-content');
      // Reset response timeout on any event — backend is alive
      resetResponseTimeout();

      switch (data.type) {
        case 'status':
          updateStatus(data.text);
          if (data.text === 'Ready') {
            updateStatus('Connected');
            clearResponseTimeout();
            saveState();
          }
          break;
        case 'delta':
          if (suppressAssistant) break;
          if (!currentStreamEl) {
            // First delta — switch status from Thinking to Generating
            if (!timerInterval) {
              updateStatus('Generating...');
            }
            lastAssistantMsg = null;
            currentStreamEl = document.createElement('div');
            currentStreamEl.className = 'chatbot-message';
            currentStreamEl.innerHTML = '<div class="msg-content"></div>';
            currentStreamWrap = document.createElement('div');
            currentStreamWrap.className = 'chatbot-msg-wrap';
            currentStreamWrap.appendChild(currentStreamEl);
            chatMessages.appendChild(currentStreamWrap);
            currentStreamText = '';
            currentThinkingEl = null;
            currentThinkingText = '';
          }
          currentStreamText += data.text;
          if (!renderTimeout) {
            renderTimeout = setTimeout(function() {
              var contentEl = currentStreamEl.querySelector('.msg-content');
              if (contentEl) contentEl.innerHTML = renderMarkdown(currentStreamText);
              chatMessages.scrollTop = chatMessages.scrollHeight;
              renderTimeout = null;
            }, 80);
          }
          break;
        case 'thinking':
          if (suppressAssistant) break;
          // New thinking block after text = new bubble
          if (currentStreamEl && currentStreamText.trim()) {
            finalizeCurrentBubble();
          }
          if (!currentStreamEl) {
            lastAssistantMsg = null;
            currentStreamEl = document.createElement('div');
            currentStreamEl.className = 'chatbot-message';
            currentStreamEl.innerHTML = '<div class="msg-content"></div>';
            currentStreamWrap = document.createElement('div');
            currentStreamWrap.className = 'chatbot-msg-wrap';
            currentStreamWrap.appendChild(currentStreamEl);
            chatMessages.appendChild(currentStreamWrap);
            currentStreamText = '';
            currentThinkingEl = null;
            currentThinkingText = '';
          }
          if (!currentThinkingEl) {
            currentThinkingEl = document.createElement('div');
            currentThinkingEl.className = 'thinking-block';
            var msgContent = currentStreamEl.querySelector('.msg-content');
            currentStreamEl.insertBefore(currentThinkingEl, msgContent);
            currentThinkingText = '';
          }
          currentThinkingText += data.text;
          currentThinkingEl.textContent = currentThinkingText;
          chatMessages.scrollTop = chatMessages.scrollHeight;
          break;
        case 'output':
          if (suppressAssistant) break;
          var outputText = (data.text || '').trim();
          if (!outputText) break;
          // Each output event = new bubble (separate assistant turn)
          finalizeCurrentBubble();
          currentStreamEl = document.createElement('div');
          currentStreamEl.className = 'chatbot-message';
          currentStreamText = outputText;
          currentStreamEl.innerHTML = '<div class="msg-content">' + renderMarkdown(currentStreamText) + '</div>';
          currentStreamWrap = document.createElement('div');
          currentStreamWrap.className = 'chatbot-msg-wrap';
          currentStreamWrap.appendChild(currentStreamEl);
          chatMessages.appendChild(currentStreamWrap);
          chatMessages.scrollTop = chatMessages.scrollHeight;
          break;
        case 'session':
          sessionId = data.session_id;
          sessionReady = true;
          saveState();
          processQueue();
          break;
        case 'error':
          stopTimer();
          clearResponseTimeout();
          addMessage('error', data.text);
          updateStatus('Error');
          if (data.text && data.text.indexOf('Invalid session') !== -1) {
            sessionStorage.removeItem('chatbot-state');
            sessionId = null;
            sessionReady = false;
            initSession();
          }
          break;
        case 'tool_use':
          // Finalize any open text bubble before showing tool activity
          finalizeCurrentBubble();
          updateStatus('Using ' + data.tool + '...');
          var toolMsg = 'Using ' + data.tool;
          if (data.input) toolMsg += ': ' + data.input.substring(0, 2000);
          var toolEl = document.createElement('div');
          toolEl.className = 'chatbot-message chatbot-message-tool';
          toolEl.style.maxHeight = '200px';
          toolEl.style.overflowY = 'auto';
          toolEl.textContent = toolMsg;
          chatMessages.appendChild(toolEl);
          chatMessages.scrollTop = chatMessages.scrollHeight;
          break;
        case 'tool_result':
          updateStatus('Thinking...');
          if (data.text) {
            var resultEl = document.createElement('div');
            resultEl.className = 'chatbot-message chatbot-message-tool';
            resultEl.style.maxHeight = '200px';
            resultEl.style.overflowY = 'auto';
            resultEl.textContent = 'Result: ' + data.text.substring(0, 4000);
            chatMessages.appendChild(resultEl);
            chatMessages.scrollTop = chatMessages.scrollHeight;
          }
          break;
        case 'goto-reload':
          if (data.target) {
            console.log('[goto-detect] backend detected /goto-reload:', data.target);
            (function(t) { setTimeout(function() { softReloadAndClick(t); }, 500); })(data.target);
          }
          break;
        case 'goto':
          if (data.target) {
            console.log('[goto-detect] backend detected /goto:', data.target);
            (function(t) { setTimeout(function() { executeGoto(t); }, 500); })(data.target);
          }
          break;
        case 'reload':
          console.log('[goto-detect] backend detected /reload');
          sessionStorage.setItem('chatbot-programmatic-reload', 'true');
          saveState();
          setTimeout(function() { window.location.reload(); }, 500);
          break;
        case 'usage':
          var elapsed = queryStartTime ? ((Date.now() - queryStartTime) / 1000).toFixed(1) : '?';
          usageShown = true;
          var totalTokens = ((data.input_tokens || 0) + (data.output_tokens || 0)).toLocaleString();
          var usageText = formatTimestamp() + ' \u00b7 ' + elapsed + 's \u00b7 ' + totalTokens + ' tokens';
          var usageTarget = currentStreamWrap || currentStreamEl;
          if (usageTarget) {
            var existingUsage = usageTarget.querySelector('.msg-usage');
            if (existingUsage) {
              existingUsage.textContent = usageText;
            } else {
              var footer = document.createElement('div');
              footer.className = 'msg-usage';
              footer.textContent = usageText;
              usageTarget.appendChild(footer);
            }
          }
          break;
        case 'done':
          stopTimer();
          clearResponseTimeout();
          currentAbortController = null;
          hideStopButton();
          currentStreamText = (currentStreamText || '').trim();
          if (currentStreamEl && currentStreamText) {
            clearTimeout(renderTimeout);
            renderTimeout = null;
            var contentEl = currentStreamEl.querySelector('.msg-content');
            if (contentEl) contentEl.innerHTML = renderMarkdown(currentStreamText);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            // Show elapsed time fallback if no usage event arrived
            if (queryStartTime && !usageShown) {
              var elapsed = ((Date.now() - queryStartTime) / 1000).toFixed(1);
              var fallbackFooter = document.createElement('div');
              fallbackFooter.className = 'msg-usage';
              fallbackFooter.textContent = formatTimestamp() + ' \u00b7 ' + elapsed + 's';
              (currentStreamWrap || currentStreamEl).appendChild(fallbackFooter);
            }
            // Auto-execute /goto-reload or /goto commands found in assistant response
            // Scan currentStreamText AND recent assistant/tool bubbles
            var allTextsToScan = [];
            if (currentStreamText) allTextsToScan.push(currentStreamText);
            var allMsgs = chatMessages.querySelectorAll('.chatbot-message:not(.chatbot-message-user)');
            console.log('[goto-detect] scanning', allMsgs.length, 'messages, currentStreamText length:', (currentStreamText || '').length);
            for (var mi = allMsgs.length - 1; mi >= Math.max(0, allMsgs.length - 5); mi--) {
              var msgContent = allMsgs[mi].querySelector('.msg-content');
              var msgText = msgContent ? msgContent.textContent || '' : allMsgs[mi].textContent || '';
              allTextsToScan.push(msgText);
            }
            var found = false;
            for (var ti = 0; ti < allTextsToScan.length && !found; ti++) {
              var scanText = allTextsToScan[ti];
              var msgLines = scanText.split('\n');
              for (var di = msgLines.length - 1; di >= 0; di--) {
                // Aggressively clean: strip backticks, non-printable chars, trim
                var doneLine = msgLines[di].replace(/[^\x20-\x7E]/g, '').trim().replace(/^`+|`+$/g, '').trim();
                if (doneLine.startsWith('/')) console.log('[goto-detect] found command line:', JSON.stringify(doneLine));
                if (doneLine.startsWith('/goto-reload ')) {
                  var gotoReloadTarget = doneLine.substring(13).trim().replace(/`/g, '').replace(/[.,;:!?`]+$/, '').trim();
                  if (gotoReloadTarget) {
                    console.log('[goto-detect] executing goto-reload:', gotoReloadTarget);
                    (function(t) { setTimeout(function() { softReloadAndClick(t); }, 500); })(gotoReloadTarget);
                  }
                  found = true;
                  break;
                } else if (doneLine.startsWith('/goto ')) {
                  var gotoTarget = doneLine.substring(6).trim().replace(/`/g, '').replace(/[.,;:!?`]+$/, '').trim();
                  if (gotoTarget) {
                    console.log('[goto-detect] executing goto:', gotoTarget);
                    (function(t) {
                      setTimeout(function() { executeGoto(t); }, 500);
                    })(gotoTarget);
                  }
                  found = true;
                  break;
                } else if (doneLine === '/reload' || doneLine === '/refresh') {
                  sessionStorage.setItem('chatbot-programmatic-reload', 'true');
                  saveState();
                  setTimeout(function() { window.location.reload(); }, 500);
                  found = true;
                  break;
                }
              }
            }
          }
          currentStreamEl = null;
          currentStreamWrap = null;
          currentStreamText = '';
          currentThinkingEl = null;
          currentThinkingText = '';
          lastAssistantMsg = null;
          queryStartTime = null;
          saveState();
          processQueue();
          break;
      }
    }

    async function initSession() {
      var namespace = detectNamespace();
      updateStatus('Connecting...');
      startResponseTimeout();
      currentAbortController = new AbortController();

      try {
        suppressAssistant = true;
        var resp = await fetch(apiBase + '/api/init', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ namespace: namespace, model: getSelectedModel() }),
          signal: currentAbortController.signal,
        });

        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        await readSSE(resp);
      } catch (e) {
        if (e.name === 'AbortError') return;
        if (isReloading) return;
        clearResponseTimeout();
        addMessage('error', 'Connection failed: ' + e.message + '. Start backend: python3 .claude/chatbot-backend/rest_server.py');
        updateStatus('Connection failed');
      } finally {
        currentAbortController = null;
        suppressAssistant = false;
        clearResponseTimeout();
      }
    }

    async function sendMessage() {
      var input = document.getElementById('chatbot-input');
      var message = input.value.trim();
      if (!message && attachedFiles.length === 0) return;

      // Handle local commands first (before sessionId check)
      if (message.startsWith('/goto ')) {
        var componentName = message.substring(6).trim();
        addMessage('user', message);
        input.value = '';
        input.style.height = '36px';
        executeGoto(componentName);
        return;
      }

      if (message.startsWith('/goto-reload ')) {
        var componentName = message.substring(13).trim();
        addMessage('user', message);
        input.value = '';
        input.style.height = '36px';
        addMessage('system', 'Reloading and navigating to ' + componentName + '...');
        saveState();
        softReloadAndClick(componentName);
        return;
      }

      // Handle /trace-view (and bare /trace with no args)
      if (message === '/trace-view' || message === '/trace-latest' || message.startsWith('/trace-view ')) {
        addMessage('user', message);
        input.value = '';
        input.style.height = '36px';
        var traceSessionId = null;
        if (message.startsWith('/trace-view ')) {
          traceSessionId = message.substring(12).trim();
        }
        openLatestTrace(traceSessionId);
        return;
      }

      // Handle /refresh and /reload
      if (message === '/refresh' || message === '/reload') {
        addMessage('user', message);
        input.value = '';
        input.style.height = '36px';
        sessionStorage.setItem('chatbot-programmatic-reload', 'true');
        saveState();
        window.location.reload();
        return;
      }

      // Handle /model command (works without a session)
      if (message.startsWith('/model')) {
        var modelArg = message.substring(6).trim().toLowerCase();
        addMessage('user', message);
        input.value = '';
        input.style.height = '36px';
        hideTypeahead();

        var modelNames = {
          'opus': 'Opus 4.6',
          'sonnet': 'Sonnet 4.6',
          'haiku': 'Haiku 4.5'
        };
        if (!modelArg || modelArg === '') {
          addMessage('system', 'Current model: ' + (modelLabels[getSelectedModel()] || getSelectedModel()));
        } else {
          var validModels = ['haiku', 'sonnet', 'opus'];
          if (validModels.indexOf(modelArg) !== -1) {
            setSelectedModel(modelArg);
            addMessage('system', 'Model changed to ' + modelLabels[modelArg]);
          } else {
            addMessage('system', 'Invalid model. Options: opus (most capable), sonnet (balanced), haiku (fast)');
          }
        }
        saveState();
        return;
      }

      // If session not ready, queue the message
      if (!sessionId) {
        messageQueue.push(message);
        addMessage('user', message);
        addMessage('system', 'Message queued — waiting for connection...');
        input.value = '';
        input.style.height = '36px';
        hideTypeahead();
        saveState();
        return;
      }

      // Show user message and clear input immediately so UI feels responsive
      var fileCount = attachedFiles.length;
      addMessage('user', message + (fileCount > 0 ? ' [' + fileCount + ' file(s) attached]' : ''));
      input.value = '';
      input.style.height = '30px';

      // Build the full prompt with file contents
      var fullMessage = message;

      if (fileCount > 0) {
        try {
          var fileContents = await readAttachedFiles();
          fullMessage = fileContents + '\n\n' + message;
        } catch (fileErr) {
          console.error('[chatbot] File reading failed:', fileErr);
          addMessage('system', 'Warning: Could not read attached files — sending message without them.');
        }
      }

      // Clear attachments
      attachedFiles = [];
      updateAttachmentUI();

      // Finalize any in-progress stream before sending a new message
      if (currentStreamEl && currentStreamText) {
        clearTimeout(renderTimeout);
        var contentEl = currentStreamEl.querySelector('.msg-content');
        if (contentEl) contentEl.innerHTML = renderMarkdown(currentStreamText);
        currentStreamEl = null;
        currentStreamText = '';
        currentThinkingEl = null;
        currentThinkingText = '';
        renderTimeout = null;
      }

      suppressAssistant = false;
      updateStatus('Thinking...');
      startTimer();
      startResponseTimeout();
      currentAbortController = new AbortController();
      showStopButton();

      try {
        var payload = JSON.stringify({ session_id: sessionId, text: fullMessage, model: getSelectedModel() });
        // Warn if payload is very large (> 1MB)
        if (payload.length > 1024 * 1024) {
          console.warn('[chatbot] Large request payload: ' + (payload.length / 1024).toFixed(0) + ' KB');
        }
        var resp = await fetch(apiBase + '/api/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: payload,
          signal: currentAbortController.signal,
        });

        if (!resp.ok) {
          var errBody = '';
          try { errBody = await resp.text(); } catch (_) {}
          throw new Error('HTTP ' + resp.status + (errBody ? ': ' + errBody.substring(0, 200) : ''));
        }
        await readSSE(resp);
      } catch (e) {
        if (e.name === 'AbortError') return;
        // Suppress errors during page reload (aborted fetches)
        if (isReloading) return;
        stopTimer();
        clearResponseTimeout();
        var errMsg = e.message || String(e);
        // TypeError: Failed to fetch — usually CORS or network-level failure
        if (e instanceof TypeError) {
          errMsg = 'Network error — backend may be down or request too large. Check console for details.';
        }
        console.error('[chatbot] Send failed:', e);
        addMessage('error', 'Send failed: ' + errMsg);
        updateStatus('Connection failed');
      } finally {
        currentAbortController = null;
        hideStopButton();
      }
    }

    function processQueue() {
      if (messageQueue.length > 0 && sessionId) {
        var nextMsg = messageQueue.shift();
        // Remove the "queued" system message for this item if present
        var content = document.getElementById('chatbot-content');
        var msgs = content.querySelectorAll('.chatbot-message-system');
        for (var i = msgs.length - 1; i >= 0; i--) {
          if (msgs[i].textContent.indexOf('Message queued') !== -1) {
            content.removeChild(msgs[i]);
            break;
          }
        }
        saveState();
        addMessage('system', 'Sending queued message...');
        sendCommandToBackend(nextMsg);
      }
    }

    // --- Slash command typeahead ---
    var slashCommands = [
      { cmd: '/connect', desc: 'Connect to a server and namespace' },
      { cmd: '/list', desc: 'List documents in the namespace (cls, mac, inc)' },
      { cmd: '/pull', desc: 'Pull a class from the server and display source' },
      { cmd: '/push', desc: 'Push a local class to the server and compile it' },
      { cmd: '/production', desc: 'Generate, create, open, or manage a production' },
      { cmd: '/host', desc: 'Add, update, remove, or list hosts in a production' },
      { cmd: '/dtl', desc: 'Create and test an HL7 Data Transformation' },
      { cmd: '/rule', desc: 'Create an HL7 Routing Rule' },
      { cmd: '/bpl', desc: 'Create a BPL visual business process' },
      { cmd: '/send', desc: 'Send HL7 messages to an HTTP service' },
      { cmd: '/trace', desc: 'Check recent message traces and event logs' },
      { cmd: '/lookup', desc: 'Create or update a lookup table' },
      { cmd: '/reset', desc: 'Delete a package from server, clear lookup tables' },
      { cmd: '/reset-force', desc: 'Force-reset — skip dry run, delete immediately' },
      { cmd: '/scaffold', desc: 'Generate production components from a description' },
      { cmd: '/json-adapter', desc: 'Generate JSON adapter classes from a payload' },
      { cmd: '/poc', desc: 'Build a full POC from a requirements document' },
      { cmd: '/goto', desc: 'Navigate to a component in the production canvas' },
      { cmd: '/goto-reload', desc: 'Reload page then navigate to a component' },
      { cmd: '/refresh', desc: 'Reload the page while preserving chat history' },
      { cmd: '/trace-view', desc: 'Open a message trace (optionally by session ID)' },
      { cmd: '/model', desc: 'Change model — opus (capable), sonnet (balanced), haiku (fast)' },
    ];

    var typeaheadEl = document.getElementById('chatbot-typeahead');
    var typeaheadIndex = -1;
    var filteredCommands = [];

    function showTypeahead(commands) {
      if (commands.length === 0) {
        hideTypeahead();
        return;
      }
      typeaheadIndex = -1;
      typeaheadEl.innerHTML = commands.map(function(c, i) {
        return '<div class="chatbot-typeahead-item" data-index="' + i + '">' +
          '<span class="chatbot-typeahead-cmd">' + c.cmd + '</span>' +
          '<span class="chatbot-typeahead-desc">' + c.desc + '</span>' +
          '</div>';
      }).join('');
      typeaheadEl.style.display = 'block';

      var items = typeaheadEl.querySelectorAll('.chatbot-typeahead-item');
      items.forEach(function(item) {
        item.addEventListener('mousedown', function(e) {
          e.preventDefault();
          var idx = parseInt(this.dataset.index);
          selectTypeahead(idx);
        });
      });
    }

    function hideTypeahead() {
      typeaheadEl.style.display = 'none';
      typeaheadIndex = -1;
      filteredCommands = [];
    }

    function selectTypeahead(index) {
      var chatInput = document.getElementById('chatbot-input');
      if (index >= 0 && index < filteredCommands.length) {
        chatInput.value = filteredCommands[index].cmd + ' ';
        chatInput.focus();
        hideTypeahead();
        chatInput.dispatchEvent(new Event('input'));
      }
    }

    function updateTypeaheadHighlight() {
      var items = typeaheadEl.querySelectorAll('.chatbot-typeahead-item');
      items.forEach(function(item, i) {
        item.classList.toggle('active', i === typeaheadIndex);
      });
      if (typeaheadIndex >= 0 && items[typeaheadIndex]) {
        items[typeaheadIndex].scrollIntoView({ block: 'nearest' });
      }
    }

    // Auto-resize textarea, typeahead, and Enter/Shift+Enter handling
    (function() {
      var chatInput = document.getElementById('chatbot-input');
      chatInput.addEventListener('input', function() {
        // Auto-resize
        this.style.height = '36px';
        var maxH = document.getElementById('chatbot-sidebar').offsetHeight * 0.4;
        this.style.height = Math.min(this.scrollHeight, maxH) + 'px';

        // Typeahead logic
        var val = this.value;
        if (val.startsWith('/')) {
          var query = val.toLowerCase();
          filteredCommands = slashCommands.filter(function(c) {
            return c.cmd.toLowerCase().indexOf(query) !== -1 ||
                   c.desc.toLowerCase().indexOf(query.substring(1)) !== -1;
          });
          showTypeahead(filteredCommands);
        } else {
          hideTypeahead();
        }
      });
      chatInput.addEventListener('keydown', function(e) {
        // Typeahead navigation
        if (typeaheadEl.style.display === 'block') {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            typeaheadIndex = Math.min(typeaheadIndex + 1, filteredCommands.length - 1);
            updateTypeaheadHighlight();
            return;
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault();
            typeaheadIndex = Math.max(typeaheadIndex - 1, 0);
            updateTypeaheadHighlight();
            return;
          }
          if (e.key === 'Tab' || (e.key === 'Enter' && typeaheadIndex >= 0)) {
            e.preventDefault();
            if (typeaheadIndex >= 0) {
              selectTypeahead(typeaheadIndex);
            } else if (filteredCommands.length > 0) {
              selectTypeahead(0);
            }
            return;
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            hideTypeahead();
            return;
          }
        }

        // Normal Enter to send
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          // Allow /goto even when input is disabled (no session needed)
          var val = this.value.trim();
          sendMessage();
        }
      });
      chatInput.addEventListener('blur', function() {
        setTimeout(hideTypeahead, 150);
      });
    })();

    function refreshApp() {
      isReloading = true;
      saveState();
      sessionStorage.setItem('chatbot-programmatic-reload', 'true');
      var overlay = document.getElementById('reload-overlay');
      if (overlay) overlay.style.display = 'block';
      window.location.reload();
    }

    // --- Soft-reload and click workflow ---
    function softReloadAndClick(componentName) {
      isReloading = true;
      sessionStorage.setItem('chatbot-click-target', componentName);
      saveState();
      sessionStorage.setItem('chatbot-programmatic-reload', 'true');

      // Show overlay to cover the reload flash
      var overlay = document.getElementById('reload-overlay');
      if (overlay) overlay.style.display = 'block';

      window.location.reload();
    }

    /** Shared goto logic used by /goto, /goto-reload, and the done-handler.
     *  Finds the component in the DOM, expands if appropriate, or falls back
     *  to resolveAndGoto when a session is available. */
    function executeGoto(componentName) {
      var found = findAndClickComponent(componentName);
      if (found) {
        addMessage('system', 'Navigated to ' + componentName);
        if (shouldExpandOnGoto(componentName)) {
