body.chatbot-fullscreen .chatbot-resize-handle{display:none}

/* Drag handle for resizing */
.chatbot-resize-handle{
  position:absolute;left:0;top:var(--fr-header-border-top-toolbar, 4px);bottom:0;width:6px;
  cursor:ew-resize;z-index:2;
  background:transparent;
  transition:background 0.15s ease;
