body.chatbot-dragging app-root{pointer-events:none;opacity:0.5}

/* Toolbar - pixel-perfect match to fr-header .mat-toolbar + .mat-toolbar-row:
   white bg, 4px primary border-top, 40px row height, box-shadow (not border-bottom),
   near-black text, xs font-size, .05rem letter-spacing */
.chatbot-toolbar{
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  padding:0 16px;
  display:flex;justify-content:space-between;align-items:center;
  height:var(--fr-header-height-toolbar, 40px);
  min-height:var(--fr-header-height-toolbar, 40px);
  border-top:var(--fr-header-border-top-toolbar, 4px) solid var(--fr-styles-color-primary);
  border-bottom:none;
  box-shadow:0 2px 8px #0000001f;
  box-sizing:content-box;
  position:relative;
  z-index:1;
  margin:0;
}
.chatbot-toolbar-title{
  display:flex;align-items:center;gap:8px;
  font-family:var(--mat-toolbar-title-text-font, 'Noto Sans','Noto Sans Arabic',Arial,sans-serif);
  font-size:var(--fr-header-font-size-top-bar-xs, var(--fr-styles-font-size-xs, .8125rem));
  font-weight:600;
  line-height:var(--mat-toolbar-title-text-line-height, 1.25rem);
  letter-spacing:.05rem;
}

/* Close button - matches toolbarIconLink: 29x29px, very-dark-grey icon color */
.chatbot-close{
  background:none;border:none;
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  font-size:16px;cursor:pointer;
  padding:0;line-height:1;
  border-radius:50%;
  transition:background 0.2s ease;
  width:29px;height:29px;
  display:flex;align-items:center;justify-content:center;
}
.chatbot-close:hover{background:rgba(0,0,0,.04)}
.chatbot-close:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:-2px;border-radius:50%}

/* Status bar */
.chatbot-status{
  background:white;
  padding:6px 16px;
  font-size:var(--fr-styles-font-size-xs);
  color:rgba(0,0,0,.6);
  border-bottom:1px solid rgba(0,0,0,.12);
  display:flex;align-items:center;gap:8px;
}
.chatbot-status-dot{
  width:8px;height:8px;border-radius:50%;
  background:var(--fr-styles-color-secondary);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}

/* Message area - matches mat-sidenav-content background */
.chatbot-content{
  flex:1;padding:12px;overflow-y:auto;
  background:var(--mat-sidenav-content-background-color, #fafafa);
  display:flex;flex-direction:column;gap:8px;
}
/* Scrollbar - matches the app global scrollbar */
.chatbot-content::-webkit-scrollbar{display:block;width:10px;position:absolute}
.chatbot-content::-webkit-scrollbar-track{background:var(--fr-styles-color-very-light-grey)}
.chatbot-content::-webkit-scrollbar-thumb{background:var(--fr-styles-color-light-grey);visibility:visible}

/* Messages */
.chatbot-message{
  background:white;
  padding:10px 14px;
  border-radius:4px;
  /* mat-elevation-z1 */
  box-shadow:0 2px 1px -1px #0003,0 1px 1px #00000024,0 1px 3px #0000001f;
  font-size:var(--fr-styles-font-size-2xs);
  line-height:1.5;
  color:rgba(0,0,0,.87);
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  word-break:break-word;
}
.chatbot-message-user{
  background:var(--fr-styles-color-primary);
  color:var(--fr-styles-color-primary-contrast, white);
  margin-left:48px;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
.chatbot-message-system{
  background:transparent;
  color:rgba(0,0,0,.54);
  font-size:var(--fr-styles-font-size-xs);
  padding:4px 8px;
  box-shadow:none;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
}
.chatbot-message-error{
  background:var(--fr-styles-color-alert-error-fill, #ffebee);
  color:var(--fr-styles-color-alert-error-border, #c62828);
  border-left:3px solid var(--fr-styles-color-alert-error-border, #c62828);
}

/* Input area */
.chatbot-input-container{
  padding:8px 12px;
  border-top:1px solid rgba(0,0,0,.12);
  background:white;
}
.chatbot-input-wrapper{display:flex;gap:8px;align-items:flex-end}

/* Input field - matches mdc-outlined-text-field */
.chatbot-input{
  flex:1;
  padding:3px 12px;
  border:1px solid var(--mdc-outlined-text-field-outline-color, rgba(0,0,0,.38));
  border-radius:4px;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  font-size:var(--fr-styles-font-size-2xs);
  color:rgba(0,0,0,.87);
  transition:border-color 0.2s ease;
  outline:none;
  height:30px;
  min-height:30px;
  max-height:40vh;
  resize:none;
  overflow-y:auto;
  line-height:1.4;
  box-sizing:border-box;
}
.chatbot-input::placeholder{color:var(--mdc-outlined-text-field-input-text-placeholder-color, rgba(0,0,0,.6))}
.chatbot-input:hover{border-color:var(--mdc-outlined-text-field-hover-outline-color, rgba(0,0,0,.87))}
.chatbot-input:focus{
  border-color:var(--fr-styles-color-state-focused);
  border-width:2px;
  padding:2px 11px;
}

/* Send button - matches mat-mdc-raised-button.mat-primary with app override height:30px */
.chatbot-send-btn{
  background:var(--fr-styles-color-primary);
  color:white;
  border:none;
  border-radius:4px;
  padding:0 12px;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  font-size:var(--fr-styles-font-size-sm);
  font-weight:600;
  cursor:pointer;
  transition:background 0.2s ease,box-shadow 0.2s ease;
  text-transform:uppercase;
  letter-spacing:0.05em;
  height:30px;
  line-height:24px;
  /* mat-elevation-z2 for raised button */
  box-shadow:0 3px 1px -2px #0003,0 2px 2px #00000024,0 1px 5px #0000001f;
}
.chatbot-send-btn:hover:not(:disabled){
  background:hsla(var(--fr-styles-color-primary-hsl), 1);
  /* mat-elevation-z4 on hover */
  box-shadow:0 2px 4px -1px #0003,0 4px 5px #00000024,0 1px 10px #0000001f;
  filter:brightness(0.85);
}
.chatbot-send-btn:disabled{
  background:rgba(0,0,0,.12);
  color:rgba(0,0,0,.38);
  cursor:not-allowed;
  box-shadow:none;
}
.chatbot-send-btn:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px;border-radius:4px}

/* Toggle button - subtle pill matching toolbar icon style */
#chatbot-toggle{
  position:fixed;bottom:12px;right:12px;
  height:30px;
  padding:0 12px;
  border-radius:4px;
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-near-black, hsl(0,0%,17%));
  border:1px solid var(--mat-divider-color, rgba(0,0,0,.12));
  cursor:pointer;
  z-index:10001;
  box-shadow:0 2px 4px -1px #0003,0 4px 5px #00000024,0 1px 10px #0000001f;
  font-size:var(--fr-styles-font-size-xs);
  font-weight:600;
  letter-spacing:.05rem;
  font-family:'Noto Sans','Noto Sans Arabic',Arial,sans-serif;
  display:none;align-items:center;justify-content:center;gap:6px;
  transition:background 0.2s ease,box-shadow 0.2s ease,border-color 0.2s ease;
}
#chatbot-toggle:hover{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border-color:rgba(0,0,0,.24);
  box-shadow:0 3px 5px -1px #0003,0 6px 10px #00000024,0 1px 18px #0000001f;
}
#chatbot-toggle:focus{outline:2px solid var(--fr-styles-color-state-focused);outline-offset:2px}
body.chatbot-closed #chatbot-toggle{display:flex}

/* Upload (paperclip) button - circular */
.chatbot-upload-btn{
  display:flex;align-items:center;justify-content:center;
  width:30px;height:30px;border-radius:50%;
  border:1px solid var(--mdc-outlined-text-field-outline-color, rgba(0,0,0,.38));
  background:var(--fr-styles-color-white, white);
  color:var(--fr-styles-color-very-dark-grey, rgba(0,0,0,.54));
  cursor:pointer;
  transition:background 0.15s ease, border-color 0.15s ease;
  flex-shrink:0;
}
.chatbot-upload-btn:hover{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border-color:var(--mdc-outlined-text-field-hover-outline-color, rgba(0,0,0,.87));
}

/* File attachment chips */
.chatbot-attachment-chip{
  display:inline-flex;align-items:center;gap:6px;
  background:var(--fr-styles-color-near-white, #fafafa);
  border:1px solid var(--fr-styles-color-light-grey, hsl(0,0%,88%));
  border-radius:16px;
  padding:4px 10px 4px 12px;
  font-size:var(--fr-styles-font-size-xs);
  color:var(--fr-styles-color-near-black);
  max-width:200px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.chatbot-attachment-remove{
  cursor:pointer;
  color:var(--fr-styles-color-dark-grey);
  font-size:14px;
  border:none;
  background:none;
  padding:0;
  width:16px;height:16px;
  border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  transition:background 0.15s ease, color 0.15s ease;
  flex-shrink:0;
}
.chatbot-attachment-remove:hover{
  color:var(--fr-styles-color-warning, red);
  background:rgba(0,0,0,.06);
}
.chatbot-attachments{
  display:flex;flex-wrap:wrap;gap:6px;
  padding:6px 0 0;
  margin-bottom:8px;
}

/* Markdown rendering styles */
.chatbot-codeblock{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:4px;
  padding:8px 12px;
  margin:6px 0;
  overflow-x:auto;
  font-family:'Noto Sans Mono',Consolas,monospace;
  font-size:var(--fr-styles-font-size-3xs);
  line-height:1.5;
  white-space:pre;
}
.chatbot-inline-code{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  border-radius:3px;
  padding:1px 4px;
  font-family:'Noto Sans Mono',Consolas,monospace;
  font-size:0.9em;
}
.chatbot-message strong{font-weight:700}
.chatbot-message em{font-style:italic}
.chatbot-h{margin:8px 0 4px;font-weight:700;line-height:1.3}
.chatbot-message h2.chatbot-h{font-size:1.1em}
.chatbot-message h3.chatbot-h{font-size:1em}
.chatbot-message h4.chatbot-h{font-size:0.95em}
.chatbot-message h5.chatbot-h{font-size:0.9em}
.chatbot-list{margin:4px 0;padding-left:20px;list-style:disc}
.chatbot-list li{margin:2px 0}
.chatbot-list-ordered{margin:4px 0;padding-left:20px;list-style:decimal}
.chatbot-list-ordered li{margin:2px 0}
.chatbot-link{color:var(--fr-styles-color-primary);text-decoration:underline}
.chatbot-link:hover{text-decoration:none}
.chatbot-table{
  width:100%;
  border-collapse:collapse;
  margin:6px 0;
  font-size:var(--fr-styles-font-size-xs);
}
.chatbot-table th,.chatbot-table td{
  border:1px solid var(--fr-styles-color-light-grey, #e0e0e0);
  padding:4px 8px;
  text-align:left;
}
.chatbot-table th{
  background:var(--fr-styles-color-very-light-grey, #f2f2f2);
  font-weight:600;
}
.chatbot-table tr:nth-child(even){background:var(--fr-styles-color-near-white, #fafafa)}
.chatbot-hr{
  border:none;
  border-top:1px solid var(--fr-styles-color-light-grey);
  margin:8px 0;
}
