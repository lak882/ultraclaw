<?xml version="1.0" encoding="UTF-8"?>
<Export generator="Cache" version="25">
  <Document name="interclaw.ZPM">
    <Module>
      <Name>interclaw</Name>
      <Version>0.0.5</Version>
      <Description>InterClaw — AI-powered interoperability skill for InterSystems IRIS. Custom Interop Editor frontend with chatbot sidebar, Python automation scripts, and Claude Code integration for building productions via natural language.</Description>
      <Keywords>claude,interoperability,ai,chatbot,hl7,production,dtl</Keywords>
      <Author>
        <Person>Louis Kabelka</Person>
        <Organization>InterSystems</Organization>
        <CopyrightDate>2026</CopyrightDate>
      </Author>
      <Packaging>module</Packaging>

      <!--
        Use durable %SYS CSP root when running in a container with ISC_DATA_DIRECTORY.
        Otherwise fall back to the normal install tree CSP root.

        Durable root:
          $SYSTEM.Util.GetEnviron("ISC_DATA_DIRECTORY")_"/csp"

        Non-container / non-durable fallback:
          $SYSTEM.Util.InstallDirectory()_"csp"
      -->

      <FileCopy
        Name="README.md"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/README.md&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/README.md&quot;)}" />

      <FileCopy
        Name="frontend/"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/frontend/&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/frontend/&quot;)}" />

      <FileCopy
        Name=".claude/"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/.claude/&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/.claude/&quot;)}" />
<!-- 
      <FileCopy
        Name="config/commands.json"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/config/&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/config/&quot;)}" /> -->

      <FileCopy
        Name="config/"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/config/&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/config/&quot;)}" />

      <FileCopy
        Name="install/InterClaw/"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/install/InterClaw/&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/install/InterClaw/&quot;)}" />

      <FileCopy
        Name="module.xml"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/module.xml&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/module.xml&quot;)}" />

      <FileCopy
        Name="requirements.txt"
        InstallDirectory="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/requirements.txt&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/requirements.txt&quot;)}" />

      <!--
        Use documented WebApplication attributes:
          Directory = physical CSP directory
          Path      = path within that directory exposed by the app

        Keep the app rooted at /ui/interop/interclaw and serve files from
        the copied frontend directory.
      -->
      <WebApplication
        Name="/ui/interop/interclaw"
        NameSpace="{$namespace}"
        MatchRoles=":%All"
        ServeFiles="1"
        Recurse="1"
        SourcePath="/frontend"
        DeployPath="#{$select($SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)'=&quot;&quot;:$SYSTEM.Util.GetEnviron(&quot;ISC_DATA_DIRECTORY&quot;)_&quot;/csp/interclaw/frontend&quot;,1:$SYSTEM.Util.InstallDirectory()_&quot;csp/interclaw/frontend&quot;)}"
        AutheEnabled="#{$$$AutheUnauthenticated}"
        CookiePath="/ui/interop/interclaw/"
        UseCookies="2"
      />

      <SourcesRoot>install</SourcesRoot>
      <Resource Name="InterClaw.PKG"/>

      <Invokes>
        <Invoke Class="InterClaw.Installer" Method="Setup" />
        <Invoke Class="InterClaw.Installer" Method="Teardown" Phase="Unconfigure" />
      </Invokes>

      <SystemRequirements Version=">=2025.1" Interoperability="enabled" />
    </Module>
  </Document>
